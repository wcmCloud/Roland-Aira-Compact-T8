# Copy to scripts/signing.local.env (git-ignored) to sign and notarize macOS builds with scripts/publish.sh.
# Names only: no passwords, keys or Apple IDs go here.
#
# The certificate's full name, as listed by: security find-identity -v -p codesigning
SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# A notarytool keychain profile, created once in a terminal with:
#   xcrun notarytool store-credentials "<profile name>" --apple-id "<apple id>" --team-id "<team id>"
# (it asks for an app-specific password and keeps it in the keychain)
NOTARY_PROFILE="<profile name>"
