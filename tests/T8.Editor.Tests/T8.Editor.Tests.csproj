<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseMidiFakes>true</UseMidiFakes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\T8.Editor\T8.Editor.csproj" />
  </ItemGroup>

  <!-- The editor ships "original presets" next to the app. Tests start from a blank library unless a test points at one. -->
  <Target Name="RemoveShippedFactoryBackup" AfterTargets="Build">
    <RemoveDir Directories="$(TargetDir)original presets" />
  </Target>

</Project>
