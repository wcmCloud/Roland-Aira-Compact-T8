<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>MIT OR GPL-3.0-only</PackageLicenseExpression>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>T8Editor</AssemblyName>
    <Product>Roland Aira Compact T-8 Editor</Product>
    <Version>1.0.3</Version>
    <Authors>Christos Christodoulidis</Authors>
    <Copyright>© 2026 Christos Christodoulidis</Copyright>
    <RootNamespace>T8.Editor</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\..\assets\icon\T8Editor.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\T8.Core\T8.Core.csproj" />
    <ProjectReference Include="..\T8.Midi\T8.Midi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app icon, drawn by scripts/make-icon.py -->
    <AvaloniaResource Include="..\..\assets\icon\T8Editor-256.png" Link="Assets\AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="T8.Editor.Tests" />
  </ItemGroup>

</Project>
