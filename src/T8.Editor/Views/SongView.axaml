<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:T8.Editor.Help"
             xmlns:vm="using:T8.Editor.ViewModels"
             xmlns:views="using:T8.Editor.Views"
             x:Class="T8.Editor.Views.SongView"
             x:DataType="vm:SongViewModel">
  <DockPanel Margin="0,8,0,0">
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8">
      <WrapPanel Orientation="Horizontal">
        <ComboBox Classes="port" ItemsSource="{Binding ExportModes}" SelectedItem="{Binding ExportMode}" Width="120" Margin="0,0,8,0"
                  ToolTip.Tip="Programs: queued pattern changes. Notes: full drum and bass notes." />
        <Button Classes="chip" Content="Export song as MIDI…" Command="{Binding ExportMidiCommand}" Margin="0,0,18,0" />
        <CheckBox Content="Follow DAW MIDI clock" IsChecked="{Binding FollowDawClock}" Margin="0,0,8,0" />
        <ComboBox Classes="port" IsVisible="{Binding FollowDawClock}" ItemsSource="{Binding ClockInputs}" SelectedItem="{Binding ClockInput}" Width="200" Margin="0,0,8,0"
                  ToolTip.Tip="Input from your DAW (IAC / loopMIDI). Press Play Song to arm, then start the DAW." />
        <Button Classes="chip" IsVisible="{Binding FollowDawClock}" Content="Refresh inputs" Command="{Binding RefreshClockInputsCommand}" />
      </WrapPanel>
    </Border>
    <!-- Song: title, copy to bank, file -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="fieldBox">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <views:HelpTip Tip="{x:Static help:HelpTips.CopyToBank}" Margin="6,-4,0,-4" />
              <TextBlock Classes="fieldLabel" Text="COPY TO BANK" Margin="2,0,4,0" />
              <ComboBox x:Name="CopyBankPicker" Classes="port" ItemsSource="{x:Static vm:SongViewModel.Banks}" SelectedItem="{Binding CopyTargetBank}" Width="62"
                        ToolTip.Tip="Bank to copy the song's patterns into" />
              <Button x:Name="CopyToBankButton" Classes="tool" Command="{Binding CopyToBankCommand}" ToolTip.Tip="Copy the song's patterns into this bank in song order (entry 1 to pattern 1…, then fills); the rest of the bank is left empty">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconCopy}" />
                  <TextBlock Text="Copy" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Classes="toolgroup">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="NewSongButton" Classes="tool" Command="{Binding NewSongCommand}" ToolTip.Tip="Start a new, empty song">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconNew}" />
                  <TextBlock Text="New song" />
                </StackPanel>
              </Button>
              <Button x:Name="OpenSongButton" Classes="tool" Command="{Binding OpenSongCommand}" ToolTip.Tip="Open a .t8song file">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconOpen}" />
                  <TextBlock Text="Open song…" />
                </StackPanel>
              </Button>
              <Button x:Name="SaveSongButton" Classes="tool" Command="{Binding SaveSongCommand}" ToolTip.Tip="Save the song">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconSave}" />
                  <TextBlock Text="Save song" />
                </StackPanel>
              </Button>
              <Button x:Name="SaveSongAsButton" Classes="tool" Command="{Binding SaveSongAsCommand}" ToolTip.Tip="Save the song to a new file">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconSaveAs}" />
                  <TextBlock Text="Save as…" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Ellipse Classes="dot" Fill="{StaticResource SectionPurple}" VerticalAlignment="Center" />
          <TextBlock Classes="cardTitle" Text="SONG" />
          <views:HelpTip Tip="{x:Static help:HelpTips.SongHeader}" />
          <Border Classes="fieldBox" Margin="6,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBlock Classes="fieldLabel" Text="TITLE" />
              <TextBox x:Name="SongTitleBox" Classes="field" Text="{Binding Title}" Width="260" Watermark="Song title" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding FileLabel}" Foreground="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Song playback and timeline -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,6,0,0">
      <StackPanel Spacing="6">
        <DockPanel>
          <Border DockPanel.Dock="Right" Classes="fieldBox">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <PathIcon Data="{StaticResource IconLoop}" Width="12" Height="12" Foreground="{StaticResource MutedText}" Margin="7,0,0,0" />
              <TextBlock Classes="fieldLabel" Text="LOOP" Margin="2,0,4,0" />
              <ComboBox x:Name="LoopEntryPicker" Classes="port" ItemsSource="{Binding LoopChoices}" SelectedItem="{Binding LoopChoice}" MinWidth="210"
                        ToolTip.Tip="Play the song once, loop the whole song from the start when it ends, or keep looping one entry" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="PlaySongButton" Classes="chip" Classes.lit="{Binding IsPlaying}" Command="{Binding PlayCommand}"
                    ToolTip.Tip="Play the song from the start (or the looped entry)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconPlay}" />
                <TextBlock Text="PLAY SONG" />
              </StackPanel>
            </Button>
            <Button x:Name="StopSongButton" Classes="chip" Command="{Binding StopCommand}" ToolTip.Tip="Stop the song">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconStop}" Width="11" Height="11" />
                <TextBlock Text="STOP" />
              </StackPanel>
            </Button>
            <Button x:Name="PreviousEntryButton" Classes="chip" Command="{Binding PreviousCommand}" Margin="8,0,0,0" ToolTip.Tip="Go to the previous entry">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconSkipPrevious}" />
                <TextBlock Text="PREVIOUS" />
              </StackPanel>
            </Button>
            <Button x:Name="NextEntryButton" Classes="chip" Command="{Binding NextCommand}" ToolTip.Tip="Go to the next entry">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="NEXT" />
                <PathIcon Data="{StaticResource IconSkipNext}" />
              </StackPanel>
            </Button>
            <views:HelpTip Tip="{x:Static help:HelpTips.SongPlayback}" />
          </StackPanel>
        </DockPanel>

        <!-- Timeline: one block per entry and per fill, as wide as its share of the song -->
        <ItemsControl x:Name="SongTimeline" ItemsSource="{Binding Timeline}" Height="24">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><views:ProportionalPanel Gap="3" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TimelineBlock">
              <Panel Classes="timelineBlock" Classes.queued="{Binding IsQueued}" Cursor="Hand"
                     ToolTip.Tip="Click to play this part next (as soon as the pattern playing now ends)">
                <ProgressBar Classes="timeline" Minimum="0" Maximum="1" Value="{Binding Progress}"
                             Background="{Binding Color, Converter={x:Static vm:Converters.HexTint}}"
                             Foreground="{Binding Color, Converter={x:Static vm:Converters.HexPlaying}}" />
                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="White" />
                <Border Classes="queuedOutline" IsVisible="{Binding IsQueued}" />
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="24">
          <StackPanel Spacing="2">
            <TextBlock Text="NOW" Classes="miniLabel" />
            <TextBlock x:Name="SongCurrentText" Text="{Binding CurrentText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <ProgressBar Classes="thin" Minimum="0" Maximum="1" Value="{Binding EntryProgress}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="NEXT" Classes="miniLabel" />
            <TextBlock x:Name="SongNextText" Text="{Binding NextText}" TextTrimming="CharacterEllipsis" />
            <ProgressBar Classes="thin green" Minimum="0" Maximum="1" Value="{Binding SongProgress}" Margin="0,4,0,0"
                         ToolTip.Tip="Whole song" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="POSITION" Classes="miniLabel" />
            <TextBlock x:Name="SongPositionText" Text="{Binding PositionText}" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="2">
            <TextBlock Text="TIME" Classes="miniLabel" />
            <TextBlock x:Name="SongTimeText" Text="{Binding TimeText}" FontSize="20" FontWeight="Bold" FontFamily="Menlo, Consolas, monospace" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Arrangement -->
    <Border Classes="card">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
            <Button x:Name="AddCurrentPatternButton" Classes="primary pill" Command="{Binding AddCurrentPatternCommand}"
                    ToolTip.Tip="Add the pattern selected in the pattern grid">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconPlus}" />
                <TextBlock Text="Add selected pattern" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Fill="{StaticResource SectionOrange}" />
            <TextBlock Classes="cardTitle" Text="ARRANGEMENT" />
            <views:HelpTip Tip="{x:Static help:HelpTips.Arrangement}" />
            <TextBlock Text="Click a pattern in the grid above to add it to the song; set how often it repeats and whether a fill leads into the next."
                       Foreground="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
        </DockPanel>

        <!-- Column headings -->
        <Grid DockPanel.Dock="Top" Classes="songColumns" ColumnDefinitions="36,66,68,86,44,*,70,66,36,146" Margin="10,0,10,4">
          <TextBlock Text="#" Classes="miniLabel" />
          <TextBlock Grid.Column="1" Text="BANK" Classes="miniLabel" />
          <TextBlock Grid.Column="2" Text="PATTERN" Classes="miniLabel" />
          <TextBlock Grid.Column="3" Text="REPEAT" Classes="miniLabel" />
          <TextBlock Grid.Column="4" Text="STEPS" Classes="miniLabel" />
          <TextBlock Grid.Column="5" Text="NAME" Classes="miniLabel" />
          <TextBlock Grid.Column="6" Grid.ColumnSpan="2" Text="FILL INTO NEXT" Classes="miniLabel" />
          <TextBlock Grid.Column="8" Grid.ColumnSpan="2" Text="COLOUR" Classes="miniLabel" />
        </Grid>

        <Panel>
          <TextBlock Text="No patterns yet. Click a pattern in the grid above to add it."
                     Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding IsEmpty}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SongEntries" ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SongEntryViewModel">
                  <Border Classes="songRow" Classes.current="{Binding IsCurrent}" Classes.queued="{Binding IsQueued}"
                          Margin="0,0,0,3">
                    <Border.Background>
                      <MultiBinding Converter="{x:Static vm:Converters.SongRowBrush}">
                        <Binding Path="Color" />
                        <Binding Path="IsCurrent" />
                      </MultiBinding>
                    </Border.Background>
                    <Grid Classes="songColumns" ColumnDefinitions="36,66,68,86,44,*,70,66,36,146">
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconPlay}" Width="9" Height="9" Foreground="{StaticResource SectionGreen}"
                                  IsVisible="{Binding IsCurrent}" />
                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="port" ItemsSource="{x:Static vm:SongViewModel.Banks}" SelectedItem="{Binding Bank}" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                ToolTip.Tip="Bank" />
                      <ComboBox Grid.Column="2" Classes="port" ItemsSource="{x:Static vm:SongViewModel.Patterns}" SelectedItem="{Binding Pattern}" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                ToolTip.Tip="Pattern" />
                      <NumericUpDown Grid.Column="3" Classes="port" Value="{Binding Repeats}" Minimum="1" Maximum="99" FormatString="0" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                     ToolTip.Tip="How many times this entry plays" />
                      <TextBlock Grid.Column="4" Text="{Binding Steps}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      <TextBox Grid.Column="5" Classes="field" Text="{Binding Name}" Watermark="Name" Margin="0,0,8,0" />
                      <ToggleButton Grid.Column="6" Classes="chip small" IsChecked="{Binding HasFill}" HorizontalAlignment="Left"
                                    ToolTip.Tip="After the repeats, play a fill pattern once as a bridge into the next entry">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <PathIcon Data="{StaticResource IconBuildUp}" Width="11" Height="11" />
                          <TextBlock Text="FILL" />
                        </StackPanel>
                      </ToggleButton>
                      <ComboBox Grid.Column="7" Classes="port" ItemsSource="{x:Static vm:SongViewModel.Patterns}" SelectedItem="{Binding FillPattern}"
                                IsEnabled="{Binding HasFill}" HorizontalAlignment="Stretch" ToolTip.Tip="Fill pattern, in the same bank" />
                      <Button Grid.Column="8" Classes="swatch" Command="{Binding NextColorCommand}" ToolTip.Tip="Change the colour">
                        <Border Background="{Binding Color, Converter={x:Static vm:Converters.HexPlaying}}" CornerRadius="3" Width="22" Height="14" />
                      </Button>
                      <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                        <Button Classes="rowTool" Command="{Binding PlayFromHereCommand}" ToolTip.Tip="Play the song from here">
                          <PathIcon Data="{StaticResource IconPlay}" />
                        </Button>
                        <Button Classes="rowTool" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move up">
                          <PathIcon Data="{StaticResource IconChevronUp}" />
                        </Button>
                        <Button Classes="rowTool" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move down">
                          <PathIcon Data="{StaticResource IconChevronDown}" />
                        </Button>
                        <Button Classes="rowTool" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate">
                          <PathIcon Data="{StaticResource IconCopy}" />
                        </Button>
                        <Button Classes="rowTool danger" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                          <PathIcon Data="{StaticResource IconTrash}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
