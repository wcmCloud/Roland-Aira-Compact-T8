<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:T8.Editor.ViewModels"
             xmlns:views="using:T8.Editor.Views"
             x:Class="T8.Editor.Views.SongView"
             x:DataType="vm:SongViewModel">
  <DockPanel Margin="0,8,0,0">
    <!-- Song: title, file, loop -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="NewSongButton" Classes="seg" Content="New song" Command="{Binding NewSongCommand}" />
          <Button x:Name="OpenSongButton" Classes="seg" Content="Open song…" Command="{Binding OpenSongCommand}" />
          <Button x:Name="SaveSongButton" Classes="seg" Content="Save song" Command="{Binding SaveSongCommand}" />
          <Button x:Name="SaveSongAsButton" Classes="seg" Content="Save as…" Command="{Binding SaveSongAsCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Ellipse Classes="dot" Fill="{StaticResource SectionPurple}" />
          <TextBlock Classes="cardTitle" Text="SONG" />
          <TextBox x:Name="SongTitleBox" Text="{Binding Title}" Width="280" Watermark="Song title" Margin="8,0,0,0" />
          <TextBlock Text="{Binding FileLabel}" Foreground="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Transport and timeline -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,10,0,0">
      <StackPanel Spacing="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ToggleButton x:Name="SongLoopToggle" Classes="seg green" Content="LOOP SONG" IsChecked="{Binding Loop}"
                          ToolTip.Tip="Start again from the first entry after the last one" />
            <TextBlock Text="Loop" Foreground="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
            <ComboBox x:Name="LoopEntryPicker" ItemsSource="{Binding LoopChoices}" SelectedItem="{Binding LoopChoice}" MinWidth="200"
                      ToolTip.Tip="Play the whole song, or keep looping one entry" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button x:Name="PlaySongButton" Classes="seg green" Classes.active="{Binding IsPlaying}" Command="{Binding PlayCommand}"
                    ToolTip.Tip="Play the song from the start (or the looped entry)">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" />
                <TextBlock Text="PLAY SONG" />
              </StackPanel>
            </Button>
            <Button x:Name="StopSongButton" Classes="seg" Command="{Binding StopCommand}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconStop}" Width="10" Height="10" />
                <TextBlock Text="STOP" />
              </StackPanel>
            </Button>
            <Button x:Name="PreviousEntryButton" Classes="seg" Command="{Binding PreviousCommand}" Margin="8,0,0,0" ToolTip.Tip="Go to the previous entry">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconLeft}" />
                <TextBlock Text="PREVIOUS" />
              </StackPanel>
            </Button>
            <Button x:Name="NextEntryButton" Classes="seg" Command="{Binding NextCommand}" ToolTip.Tip="Go to the next entry">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="NEXT" />
                <PathIcon Data="{StaticResource IconRight}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>

        <!-- Timeline: one block per entry and per fill, as wide as its share of the song -->
        <ItemsControl x:Name="SongTimeline" ItemsSource="{Binding Timeline}" Height="34">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><views:ProportionalPanel Gap="3" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TimelineBlock">
              <Panel ToolTip.Tip="{Binding Label}">
                <ProgressBar Classes="timeline" Minimum="0" Maximum="1" Value="{Binding Progress}"
                             Background="{Binding Color, Converter={x:Static vm:Converters.HexTint}}"
                             Foreground="{Binding Color, Converter={x:Static vm:Converters.HexBrush}}"
                             Opacity="{Binding IsFill, Converter={x:Static vm:Converters.FillOpacity}}" />
                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="White" />
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="24">
          <StackPanel Spacing="2">
            <TextBlock Text="NOW" Classes="miniLabel" />
            <TextBlock x:Name="SongCurrentText" Text="{Binding CurrentText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <ProgressBar Classes="thin" Minimum="0" Maximum="1" Value="{Binding EntryProgress}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="NEXT" Classes="miniLabel" />
            <TextBlock x:Name="SongNextText" Text="{Binding NextText}" TextTrimming="CharacterEllipsis" />
            <ProgressBar Classes="thin green" Minimum="0" Maximum="1" Value="{Binding SongProgress}" Margin="0,4,0,0"
                         ToolTip.Tip="Whole song" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="POSITION" Classes="miniLabel" />
            <TextBlock x:Name="SongPositionText" Text="{Binding PositionText}" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="2">
            <TextBlock Text="TIME" Classes="miniLabel" />
            <TextBlock x:Name="SongTimeText" Text="{Binding TimeText}" FontSize="20" FontWeight="Bold" FontFamily="Menlo, Consolas, monospace" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Arrangement -->
    <Border Classes="card">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
            <Button x:Name="AddCurrentPatternButton" Classes="primary" Command="{Binding AddCurrentPatternCommand}"
                    ToolTip.Tip="Add the pattern selected in the pattern grid">
              <TextBlock Text="+ Add selected pattern" />
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Fill="{StaticResource SectionOrange}" />
            <TextBlock Classes="cardTitle" Text="ARRANGEMENT" />
            <TextBlock Text="Click a pattern in the grid above to add it to the song; set how often it repeats and whether a fill leads into the next."
                       Foreground="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
        </DockPanel>

        <!-- Column headings -->
        <Grid DockPanel.Dock="Top" Classes="songColumns" ColumnDefinitions="44,72,80,96,56,*,70,72,48,170" Margin="10,0,10,4">
          <TextBlock Text="#" Classes="miniLabel" />
          <TextBlock Grid.Column="1" Text="BANK" Classes="miniLabel" />
          <TextBlock Grid.Column="2" Text="PATTERN" Classes="miniLabel" />
          <TextBlock Grid.Column="3" Text="REPEAT" Classes="miniLabel" />
          <TextBlock Grid.Column="4" Text="STEPS" Classes="miniLabel" />
          <TextBlock Grid.Column="5" Text="NAME" Classes="miniLabel" />
          <TextBlock Grid.Column="6" Grid.ColumnSpan="2" Text="FILL INTO NEXT" Classes="miniLabel" />
          <TextBlock Grid.Column="8" Text="COLOUR" Classes="miniLabel" />
        </Grid>

        <Panel>
          <TextBlock Text="No patterns yet. Click a pattern in the grid above to add it."
                     Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding IsEmpty}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SongEntries" ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SongEntryViewModel">
                  <Border Classes="songRow" Classes.current="{Binding IsCurrent}"
                          Background="{Binding Color, Converter={x:Static vm:Converters.HexTint}}" Margin="0,0,0,4">
                    <Grid Classes="songColumns" ColumnDefinitions="44,72,80,96,56,*,70,72,48,170">
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconPlay}" Width="10" Height="10" Foreground="{StaticResource SectionGreen}"
                                  IsVisible="{Binding IsCurrent}" />
                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SongViewModel.Banks}" SelectedItem="{Binding Bank}" HorizontalAlignment="Stretch" />
                      <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:SongViewModel.Patterns}" SelectedItem="{Binding Pattern}" HorizontalAlignment="Stretch" />
                      <NumericUpDown Grid.Column="3" Value="{Binding Repeats}" Minimum="1" Maximum="99" FormatString="0" HorizontalAlignment="Stretch" />
                      <TextBlock Grid.Column="4" Text="{Binding Steps}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      <TextBox Grid.Column="5" Text="{Binding Name}" Watermark="Name" />
                      <ToggleButton Grid.Column="6" Classes="seg blue" Content="FILL" IsChecked="{Binding HasFill}"
                                    ToolTip.Tip="After the repeats, play a fill pattern once as a bridge into the next entry" />
                      <ComboBox Grid.Column="7" ItemsSource="{x:Static vm:SongViewModel.Patterns}" SelectedItem="{Binding FillPattern}"
                                IsEnabled="{Binding HasFill}" HorizontalAlignment="Stretch" ToolTip.Tip="Fill pattern, in the same bank" />
                      <Button Grid.Column="8" Classes="swatch" Command="{Binding NextColorCommand}" ToolTip.Tip="Change the colour">
                        <Border Background="{Binding Color, Converter={x:Static vm:Converters.HexBrush}}" CornerRadius="3" Width="28" Height="18" />
                      </Button>
                      <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                        <Button Classes="seg mini" Command="{Binding PlayFromHereCommand}" ToolTip.Tip="Play the song from here">
                          <PathIcon Data="{StaticResource IconPlay}" Width="10" Height="10" />
                        </Button>
                        <Button Classes="seg mini" Content="▲" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move up" />
                        <Button Classes="seg mini" Content="▼" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move down" />
                        <Button Classes="seg mini" Content="⧉" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate" />
                        <Button Classes="seg mini" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
