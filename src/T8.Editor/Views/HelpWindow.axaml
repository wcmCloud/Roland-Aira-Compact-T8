<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:T8.Editor.Help"
        x:Class="T8.Editor.Views.HelpWindow"
        x:DataType="help:HelpTopic"
        Icon="avares://T8Editor/Assets/AppIcon.png"
        Title="Help"
        Width="860" Height="580" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}">
  <DockPanel Margin="16">
    <!-- Header -->
    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="OnlineGuideButton" Classes="chip" Click="OnOnlineGuide" ToolTip.Tip="The full user guide with screenshots, on GitHub">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconOpen}" />
            <TextBlock Text="ONLINE USER GUIDE" />
          </StackPanel>
        </Button>
        <Button x:Name="CloseHelpButton" Classes="chip" Click="OnClose" IsCancel="True">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconClose}" />
            <TextBlock Text="CLOSE" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="logo" Text="T-8" />
        <TextBlock Text="Help" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>

    <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
      <!-- Topics -->
      <Border Classes="card" Padding="6">
        <ListBox x:Name="TopicList" Classes="helpTopics" SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="help:HelpTopic">
              <TextBlock Text="{Binding Title}" FontSize="12" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- The topic -->
      <Border Grid.Column="1" Classes="card" Padding="18,14">
        <ScrollViewer x:Name="TopicScroller" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="dot" Fill="{StaticResource T8Orange}" />
              <TextBlock x:Name="TopicTitle" Text="{Binding Title}" FontSize="15" FontWeight="Bold" />
            </StackPanel>
            <ItemsControl x:Name="TopicParagraphs" ItemsSource="{Binding Paragraphs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Margin="0,0,0,10" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
