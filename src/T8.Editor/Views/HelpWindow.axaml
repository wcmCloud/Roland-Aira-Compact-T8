<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:T8.Editor.Help"
        xmlns:views="using:T8.Editor.Views"
        x:Class="T8.Editor.Views.HelpWindow"
        Icon="avares://T8Editor/Assets/AppIcon.png"
        Title="Help"
        Width="880" Height="600" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}">
  <DockPanel Margin="16">
    <!-- Header -->
    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,12">
      <Button x:Name="CloseHelpButton" DockPanel.Dock="Right" Classes="chip" Click="OnClose" IsCancel="True">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource IconClose}" />
          <TextBlock Text="CLOSE" />
        </StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="logo" Text="T-8" />
        <TextBlock Text="Help" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>

    <Grid ColumnDefinitions="240,*" ColumnSpacing="12">
      <!-- Search and topics -->
      <Border Classes="card" Padding="8">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="fieldBox" Margin="0,0,0,8">
            <DockPanel>
              <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconSearch}" Width="12" Height="12"
                        Foreground="{StaticResource MutedText}" Margin="8,0,2,0" />
              <TextBox x:Name="SearchBox" Classes="field" Watermark="Search help" />
            </DockPanel>
          </Border>
          <Button x:Name="OnlineGuideButton" DockPanel.Dock="Bottom" Classes="chip" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Margin="0,8,0,0" Click="OnOnlineGuide"
                  ToolTip.Tip="The full user guide with screenshots, on GitHub">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconOpen}" />
              <TextBlock Text="ONLINE GUIDE" />
            </StackPanel>
          </Button>
          <TextBlock x:Name="NoResultsText" DockPanel.Dock="Top" Text="Nothing found." FontSize="11.5"
                     Foreground="{StaticResource MutedText}" Margin="6,4" IsVisible="False" />
          <ListBox x:Name="TopicList" Classes="helpTopics" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="help:HelpTopic">
                <TextBlock Text="{Binding Title}" FontSize="12" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- The topic -->
      <Border Grid.Column="1" Classes="card" Padding="20,16">
        <ScrollViewer x:Name="TopicScroller" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="dot" Fill="{StaticResource T8Orange}" />
              <TextBlock x:Name="TopicTitle" Classes="cardTitle" FontSize="13" />
            </StackPanel>
            <views:MarkdownView x:Name="TopicText" TextSize="12.5" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
