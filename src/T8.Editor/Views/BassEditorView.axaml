<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:T8.Editor.Help"
             xmlns:vm="using:T8.Editor.ViewModels"
             xmlns:views="using:T8.Editor.Views"
             x:Class="T8.Editor.Views.BassEditorView"
             x:DataType="vm:BassEditorViewModel">
  <DockPanel Margin="0,8,0,0">
    <!-- Pattern settings: a card like the generator panels, with outlined boxes like KEY / SCALE / OUT -->
    <Border x:Name="BassPatternPanel" DockPanel.Dock="Top" Classes="card strip" HorizontalAlignment="Left" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Ellipse Classes="dot" Fill="{StaticResource SectionPink}" />
          <TextBlock Classes="cardTitle" Text="PATTERN" />
          <views:HelpTip Tip="{x:Static help:HelpTips.BassPattern}" />
        </StackPanel>
        <Border Classes="fieldBox">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock Classes="fieldLabel" Text="LAST STEP" />
            <NumericUpDown x:Name="BassLength" Classes="port" Value="{Binding Length}" Minimum="1" Maximum="32" FormatString="0" Width="92"
                           ToolTip.Tip="The pattern plays steps 1 to this one" />
          </StackPanel>
        </Border>
        <ToggleButton x:Name="TripletCheck" Classes="chip orange" IsChecked="{Binding Triplet}" VerticalAlignment="Center"
                      ToolTip.Tip="Triplet timing: three steps in the time of two">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{StaticResource IconTriplet}" />
            <TextBlock Text="TRIPLET" />
          </StackPanel>
        </ToggleButton>
        <Border x:Name="TransposeBox" Classes="fieldBox">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <PathIcon Data="{StaticResource IconTranspose}" Width="12" Height="12" Foreground="{StaticResource MutedText}" Margin="7,0,0,0" />
            <TextBlock Classes="fieldLabel" Text="TRANSPOSE" Margin="2,0,4,0" />
            <Button x:Name="TransposeDown12Button" Classes="chip small" Content="−12" Command="{Binding TransposeCommand}"
                    ToolTip.Tip="Transpose every note down 12 semitones (an octave)">
              <Button.CommandParameter><x:Int32>-12</x:Int32></Button.CommandParameter>
            </Button>
            <Button x:Name="TransposeDown1Button" Classes="chip small" Content="−1" Command="{Binding TransposeCommand}"
                    ToolTip.Tip="Transpose every note down 1 semitone">
              <Button.CommandParameter><x:Int32>-1</x:Int32></Button.CommandParameter>
            </Button>
            <Button x:Name="TransposeUp1Button" Classes="chip small" Content="+1" Command="{Binding TransposeCommand}"
                    ToolTip.Tip="Transpose every note up 1 semitone">
              <Button.CommandParameter><x:Int32>1</x:Int32></Button.CommandParameter>
            </Button>
            <Button x:Name="TransposeUp12Button" Classes="chip small" Content="+12" Command="{Binding TransposeCommand}"
                    ToolTip.Tip="Transpose every note up 12 semitones (an octave)">
              <Button.CommandParameter><x:Int32>12</x:Int32></Button.CommandParameter>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel HorizontalAlignment="Left">
        <ItemsControl x:Name="BassSteps" ItemsSource="{Binding Steps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BassStepViewModel">
              <Border Classes="bassStep" Classes.beat="{Binding IsBeat}" Classes.outside="{Binding !IsInLength}"
                      Classes.selected="{Binding IsSelected}" Classes.playing="{Binding IsPlaying}" ContextRequested="OnStepContextRequested">
                <StackPanel Spacing="3">
                  <Button Classes="stepNumber" Content="{Binding Number}" Command="{Binding SelectCommand}"
                          ToolTip.Tip="Select this step" />
                  <Button Classes="note" Classes.on="{Binding HasNote}" Content="{Binding NoteName}"
                          Command="{Binding SelectCommand}" ToolTip.Tip="Select, then play a key below (right-click for all notes)" />
                  <Button Classes="state" Classes.on="{Binding HasNote}" Content="{Binding StateLabel}"
                          Command="{Binding CycleStateCommand}" ToolTip.Tip="Off → Note → Tie" />
                  <UniformGrid Columns="2">
                    <Button Content="▲" Command="{Binding NoteUpCommand}" ToolTip.Tip="Semitone up" />
                    <Button Content="▼" Command="{Binding NoteDownCommand}" ToolTip.Tip="Semitone down" />
                  </UniformGrid>
                  <ToggleButton Content="Acc" IsChecked="{Binding Accent}" ToolTip.Tip="Accent" />
                  <ToggleButton Content="Slide" IsChecked="{Binding Slide}" ToolTip.Tip="Slide" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Keyboard: plays a note into the selected step -->
        <!-- Step editor: a card like the PATTERN panel -->
        <Border x:Name="StepEditorPanel" Classes="card strip" HorizontalAlignment="Left" Margin="0,10,0,6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Ellipse Classes="dot" Fill="{StaticResource SectionPurple}" />
              <TextBlock Classes="cardTitle" Text="STEP EDITOR" />
              <views:HelpTip Tip="{x:Static help:HelpTips.BassStepEditor}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button x:Name="PreviousStepButton" Classes="chip" Command="{Binding SelectPreviousCommand}" Padding="7,0"
                      ToolTip.Tip="Select the previous step">
                <PathIcon Data="{StaticResource IconLeft}" />
              </Button>
              <Border x:Name="StepPickerBox" Classes="fieldBox" MinHeight="28" Padding="10,0">
                <TextBlock x:Name="SelectionText" Text="{Binding SelectionLabel}" MinWidth="104" TextAlignment="Center" FontSize="11.5"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
              </Border>
              <Button x:Name="NextStepButton" Classes="chip" Command="{Binding SelectNextCommand}" Padding="7,0"
                      ToolTip.Tip="Select the next step">
                <PathIcon Data="{StaticResource IconRight}" />
              </Button>
            </StackPanel>
            <ToggleButton x:Name="AdvanceCheck" Classes="chip orange" IsChecked="{Binding AdvanceAfterNote}" VerticalAlignment="Center"
                          ToolTip.Tip="After you pick a note on the keyboard, select the next step">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconSkipNext}" />
                <TextBlock Text="NEXT STEP AFTER A NOTE" />
              </StackPanel>
            </ToggleButton>
            <StackPanel x:Name="StepEditorHint" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="2,0,4,0">
              <PathIcon Data="{StaticResource IconInfo}" Width="11" Height="11" Foreground="{StaticResource MutedText}" />
              <TextBlock Text="Click a step, then a key here. Right-click a step for all notes." Foreground="{StaticResource MutedText}" FontSize="11"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
        <views:PianoKeyboard x:Name="BassKeyboard" HorizontalAlignment="Left"
                             LowestNote="{x:Static vm:BassEditorViewModel.LowestNote}"
                             HighestNote="{x:Static vm:BassEditorViewModel.HighestNote}"
                             HighlightedNote="{Binding SelectedNote}"
                             PlayingNote="{Binding PlayingNote}"
                             Command="{Binding EnterNoteCommand}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
