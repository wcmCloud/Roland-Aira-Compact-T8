<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:T8.Editor.ViewModels"
             x:Class="T8.Editor.Views.BassEditorView"
             x:DataType="vm:BassEditorViewModel">
  <DockPanel Margin="0,8,0,0">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Classes="header" Text="Last step" />
      <NumericUpDown x:Name="BassLength" Value="{Binding Length}" Minimum="1" Maximum="32" FormatString="0" Width="120" />
      <CheckBox x:Name="TripletCheck" Content="Triplet" IsChecked="{Binding Triplet}" />
      <TextBlock Classes="header" Text="Transpose" Margin="16,0,0,0" />
      <Button Content="−12" Command="{Binding TransposeCommand}">
        <Button.CommandParameter><x:Int32>-12</x:Int32></Button.CommandParameter>
      </Button>
      <Button Content="−1" Command="{Binding TransposeCommand}">
        <Button.CommandParameter><x:Int32>-1</x:Int32></Button.CommandParameter>
      </Button>
      <Button Content="+1" Command="{Binding TransposeCommand}">
        <Button.CommandParameter><x:Int32>1</x:Int32></Button.CommandParameter>
      </Button>
      <Button Content="+12" Command="{Binding TransposeCommand}">
        <Button.CommandParameter><x:Int32>12</x:Int32></Button.CommandParameter>
      </Button>
    </StackPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Auto">
      <ItemsControl x:Name="BassSteps" ItemsSource="{Binding Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BassStepViewModel">
            <Border Classes="bassStep" Classes.beat="{Binding IsBeat}" Classes.outside="{Binding !IsInLength}">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" FontSize="11" Opacity="0.6" />
                <Button Classes="state" Classes.on="{Binding HasNote}" Content="{Binding StateLabel}"
                        Command="{Binding CycleStateCommand}" ToolTip.Tip="Off → Note → Tie" />
                <Button Content="+12" Command="{Binding OctaveUpCommand}" />
                <Button Content="▲" Command="{Binding NoteUpCommand}" />
                <TextBlock Text="{Binding NoteName}" HorizontalAlignment="Center" FontWeight="SemiBold"
                           Opacity="{Binding HasNote, Converter={x:Static vm:Converters.HasNoteOpacity}}" />
                <Button Content="▼" Command="{Binding NoteDownCommand}" />
                <Button Content="−12" Command="{Binding OctaveDownCommand}" />
                <ToggleButton Content="Acc" IsChecked="{Binding Accent}" ToolTip.Tip="Accent" />
                <ToggleButton Content="Slide" IsChecked="{Binding Slide}" ToolTip.Tip="Slide" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
