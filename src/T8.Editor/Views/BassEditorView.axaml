<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:T8.Editor.ViewModels"
             xmlns:views="using:T8.Editor.Views"
             x:Class="T8.Editor.Views.BassEditorView"
             x:DataType="vm:BassEditorViewModel">
  <DockPanel Margin="0,8,0,0">
    <!-- Pattern settings in one outlined panel, like the generators' boxes -->
    <Border DockPanel.Dock="Top" Classes="fieldBox" HorizontalAlignment="Left" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="3">
        <TextBlock Classes="fieldLabel" Text="LAST STEP" />
        <NumericUpDown x:Name="BassLength" Classes="port" Value="{Binding Length}" Minimum="1" Maximum="32" FormatString="0" Width="96"
                       ToolTip.Tip="The pattern plays steps 1 to this one" />
        <Rectangle Classes="boxDivider" />
        <ToggleButton x:Name="TripletCheck" Classes="chip" IsChecked="{Binding Triplet}" ToolTip.Tip="Triplet timing: three steps in the time of two">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{StaticResource IconTriplet}" />
            <TextBlock Text="TRIPLET" />
          </StackPanel>
        </ToggleButton>
        <Rectangle Classes="boxDivider" />
        <TextBlock Classes="fieldLabel" Text="TRANSPOSE" />
        <Button x:Name="TransposeDown12Button" Classes="tool" Content="−12" Command="{Binding TransposeCommand}"
                ToolTip.Tip="Transpose every note down 12 semitones (an octave)">
          <Button.CommandParameter><x:Int32>-12</x:Int32></Button.CommandParameter>
        </Button>
        <Button x:Name="TransposeDown1Button" Classes="tool" Content="−1" Command="{Binding TransposeCommand}"
                ToolTip.Tip="Transpose every note down 1 semitone">
          <Button.CommandParameter><x:Int32>-1</x:Int32></Button.CommandParameter>
        </Button>
        <Button x:Name="TransposeUp1Button" Classes="tool" Content="+1" Command="{Binding TransposeCommand}"
                ToolTip.Tip="Transpose every note up 1 semitone">
          <Button.CommandParameter><x:Int32>1</x:Int32></Button.CommandParameter>
        </Button>
        <Button x:Name="TransposeUp12Button" Classes="tool" Content="+12" Command="{Binding TransposeCommand}"
                ToolTip.Tip="Transpose every note up 12 semitones (an octave)">
          <Button.CommandParameter><x:Int32>12</x:Int32></Button.CommandParameter>
        </Button>
      </StackPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel HorizontalAlignment="Left">
        <ItemsControl x:Name="BassSteps" ItemsSource="{Binding Steps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BassStepViewModel">
              <Border Classes="bassStep" Classes.beat="{Binding IsBeat}" Classes.outside="{Binding !IsInLength}"
                      Classes.selected="{Binding IsSelected}" Classes.playing="{Binding IsPlaying}" ContextRequested="OnStepContextRequested">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" FontSize="11" Opacity="0.6" />
                  <Button Classes="note" Classes.on="{Binding HasNote}" Content="{Binding NoteName}"
                          Command="{Binding SelectCommand}" ToolTip.Tip="Select, then play a key below (right-click for all notes)" />
                  <Button Classes="state" Classes.on="{Binding HasNote}" Content="{Binding StateLabel}"
                          Command="{Binding CycleStateCommand}" ToolTip.Tip="Off → Note → Tie" />
                  <UniformGrid Columns="2">
                    <Button Content="▲" Command="{Binding NoteUpCommand}" ToolTip.Tip="Semitone up" />
                    <Button Content="▼" Command="{Binding NoteDownCommand}" ToolTip.Tip="Semitone down" />
                  </UniformGrid>
                  <ToggleButton Content="Acc" IsChecked="{Binding Accent}" ToolTip.Tip="Accent" />
                  <ToggleButton Content="Slide" IsChecked="{Binding Slide}" ToolTip.Tip="Slide" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Keyboard: plays a note into the selected step -->
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,16,0,6">
          <Button Classes="seg" Command="{Binding SelectPreviousCommand}" ToolTip.Tip="Select the previous step">
            <PathIcon Data="{StaticResource IconLeft}" />
        </Button>
          <TextBlock x:Name="SelectionText" Classes="header" Text="{Binding SelectionLabel}" MinWidth="150" />
          <Button Classes="seg" Command="{Binding SelectNextCommand}" ToolTip.Tip="Select the next step">
            <PathIcon Data="{StaticResource IconRight}" />
        </Button>
          <CheckBox x:Name="AdvanceCheck" Content="Go to the next step after a note" IsChecked="{Binding AdvanceAfterNote}" Margin="8,0,0,0" />
          <TextBlock Text="Click a step, then a key. Right-click a step for all notes." Opacity="0.6" FontSize="12"
                     VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <views:PianoKeyboard x:Name="BassKeyboard" HorizontalAlignment="Left"
                             LowestNote="{x:Static vm:BassEditorViewModel.LowestNote}"
                             HighestNote="{x:Static vm:BassEditorViewModel.HighestNote}"
                             HighlightedNote="{Binding SelectedNote}"
                             PlayingNote="{Binding PlayingNote}"
                             Command="{Binding EnterNoteCommand}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
