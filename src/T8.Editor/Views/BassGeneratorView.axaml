<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:T8.Editor.Help"
             xmlns:vm="using:T8.Editor.ViewModels"
             xmlns:views="using:T8.Editor.Views"
             x:Class="T8.Editor.Views.BassGeneratorView"
             x:DataType="vm:BassGeneratorViewModel">
  <Border Classes="card">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="7" Margin="0,0,0,8">
        <Ellipse Classes="dot" Fill="{StaticResource SectionPink}" />
        <TextBlock Classes="cardTitle" Text="BASS LINE GENERATOR" />
        <views:HelpTip Tip="{x:Static help:HelpTips.BassGenerator}" />
      </StackPanel>

      <!-- Generate, randomize, undo and seed in one outlined panel -->
      <Border x:Name="BassActionPanel" DockPanel.Dock="Right" Classes="fieldBox" Padding="8" VerticalAlignment="Center" Margin="16,0,0,0" Width="250">
        <StackPanel Spacing="7">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Fill="{StaticResource SectionPink}" />
            <TextBlock Classes="cardTitle" Text="ACTIONS" FontSize="10" />
          </StackPanel>
          <Button x:Name="GenerateButton" Classes="primary pill" Command="{Binding GenerateCommand}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" ToolTip.Tip="Write a line with these settings and seed (same seed, same line)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconGenerate}" />
              <TextBlock Text="Generate" />
            </StackPanel>
          </Button>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="RandomizeButton" Classes="chip" Command="{Binding RandomizeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    ToolTip.Tip="New seed: a different line that follows the same rules">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconDice}" />
                <TextBlock Text="RANDOMIZE" />
              </StackPanel>
            </Button>
            <Button x:Name="UndoGenerateButton" Grid.Column="1" Classes="chip" Command="{Binding UndoCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    ToolTip.Tip="Undo the last generate">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconUndo}" />
                <TextBlock Text="UNDO" />
              </StackPanel>
            </Button>
          </Grid>
          <Border Classes="fieldBox" MinHeight="0" Padding="0">
            <DockPanel>
              <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconSeed}" Width="11" Height="11" Foreground="{StaticResource MutedText}" Margin="10,0,0,0" />
              <TextBlock DockPanel.Dock="Left" Classes="fieldLabel" Text="SEED" Margin="6,0,4,0" />
              <NumericUpDown Classes="port" x:Name="SeedInput" Value="{Binding Seed}" Minimum="1" Maximum="99999" FormatString="0" ShowButtonSpinner="False"
                             ToolTip.Tip="Same seed and settings, same result: type a number to get one back" />
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Harmony: outlined boxes like OUT in the top bar -->
      <StackPanel DockPanel.Dock="Left" Spacing="5" Margin="0,0,18,0" VerticalAlignment="Center">
        <Border Classes="fieldBox" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="fieldLabel" Text="KEY" Width="54" />
            <ComboBox x:Name="KeyPicker" Classes="port" ItemsSource="{x:Static vm:BassGeneratorViewModel.Keys}" SelectedItem="{Binding Key}" Width="216" />
          </StackPanel>
        </Border>
        <Border Classes="fieldBox" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="fieldLabel" Text="SCALE" Width="54" />
            <ComboBox x:Name="ScalePicker" Classes="port" ItemsSource="{x:Static vm:BassGeneratorViewModel.Scales}" SelectedItem="{Binding Scale}" Width="216" />
          </StackPanel>
        </Border>
        <Border Classes="fieldBox" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="fieldLabel" Text="CHORDS" Width="54" />
            <ComboBox x:Name="ProgressionPicker" Classes="port" ItemsSource="{x:Static vm:BassGeneratorViewModel.Progressions}" SelectedItem="{Binding Progression}" Width="150" />
            <ComboBox x:Name="ChordLengthPicker" Classes="port" ItemsSource="{x:Static vm:BassGeneratorViewModel.ChordLengths}" SelectedItem="{Binding StepsPerChord}" Width="62"
                      ToolTip.Tip="Steps per chord" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Range and chances -->
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <views:Knob x:Name="OctaveKnob" Value="{Binding LowestOctave}" Minimum="0" Maximum="5" DefaultValue="1" Label="From octave"
                    Accent="{StaticResource SectionPurple}" ToolTip.Tip="Octave of the lowest note (C1 is the classic bass range)" />
        <views:Knob x:Name="OctaveSpanKnob" Value="{Binding Octaves}" Minimum="1" Maximum="4" DefaultValue="2" Label="Octaves"
                    Accent="{StaticResource SectionPurple}" Margin="0,0,14,0" ToolTip.Tip="How many octaves the line may span" />
        <views:Knob x:Name="NoteChanceKnob" Value="{Binding NoteChance}" Format="{}{0}%" DefaultValue="65" Label="Notes"
                    Accent="{StaticResource SectionPink}" ToolTip.Tip="How often a step plays a new note (beats get a bonus)" />
        <views:Knob Value="{Binding ChordToneChance}" Format="{}{0}%" DefaultValue="75" Label="Chord tones"
                    Accent="{StaticResource SectionPink}" ToolTip.Tip="How often a note on the beat is a chord tone (root, third, fifth)" />
        <views:Knob Value="{Binding TieChance}" Format="{}{0}%" DefaultValue="20" Label="Ties"
                    Accent="{StaticResource SectionPink}" ToolTip.Tip="How often a rest after a note holds it instead" />
        <views:Knob Value="{Binding SlideChance}" Format="{}{0}%" DefaultValue="15" Label="Slides" Accent="{StaticResource SectionPink}" />
        <views:Knob Value="{Binding AccentChance}" Format="{}{0}%" DefaultValue="25" Label="Accents" Accent="{StaticResource SectionPink}" />
        <views:Knob Value="{Binding OctaveJumpChance}" Format="{}{0}%" DefaultValue="15" Label="Octave jumps"
                    Accent="{StaticResource SectionPink}" ToolTip.Tip="How often a note jumps an octave up or down" />
      </WrapPanel>
    </DockPanel>
  </Border>
</UserControl>
