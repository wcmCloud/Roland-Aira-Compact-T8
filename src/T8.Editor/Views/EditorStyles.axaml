    <SolidColorBrush x:Key="BarBg" Color="#0B0B0D" />
    <SolidColorBrush x:Key="CardBg" Color="#18181C" />
    <SolidColorBrush x:Key="CardBorder" Color="#29292F" />
    <SolidColorBrush x:Key="Outline" Color="#34343B" />
    <SolidColorBrush x:Key="MutedText" Color="#9A9AA2" />
    <SolidColorBrush x:Key="SectionOrange" Color="#FF7A1A" />
    <SolidColorBrush x:Key="SectionGreen" Color="#4CD38A" />
    <SolidColorBrush x:Key="SectionBlue" Color="#4AA8FF" />
    <SolidColorBrush x:Key="SectionPink" Color="#FF5C8A" />
    <SolidColorBrush x:Key="SectionPurple" Color="#B57BFF" />
  </Styles.Resources>

  <!-- Window chrome: top bar, cards with a coloured dot and title -->
  <Style Selector="Border.topbar">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#1B1B21" />
        <GradientStop Offset="1" Color="#0D0D10" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <!-- A thin orange line under the top bar -->
  <Style Selector="Border.topbarAccent">
    <Setter Property="Height" Value="2" />
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#FF7A1A" />
        <GradientStop Offset="0.45" Color="#55FF7A1A" />
        <GradientStop Offset="1" Color="#00FF7A1A" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <!-- Groups of top bar buttons in one rounded box -->
  <Style Selector="Border.toolgroup">
    <Setter Property="Background" Value="#141418" />
    <Setter Property="BorderBrush" Value="#2C2C33" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.toolgroup Button.tool, Border.fieldBox Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A2A32" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.38" />
  </Style>
  <Style Selector="Button.tool PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Foreground" Value="#C9C9D1" />
  </Style>
  <Style Selector="Button.tool.t8 PathIcon">
    <Setter Property="Foreground" Value="{StaticResource T8Orange}" />
  </Style>
  <Style Selector="Border.logoBadge">
    <Setter Property="Background" Value="#22FF7A1A" />
    <Setter Property="BorderBrush" Value="#66FF7A1A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.driveDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Margin" Value="6,0,3,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="#55555E" />
  </Style>
  <Style Selector="Ellipse.driveDot.on">
    <Setter Property="Fill" Value="{StaticResource SectionGreen}" />
  </Style>
  <Style Selector="ComboBox.port">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="9,0,6,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="#141418" />
    <Setter Property="BorderBrush" Value="#2C2C33" />
  </Style>
  <Style Selector="Border.card, Border.panel">
    <Setter Property="Background" Value="{StaticResource CardBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.logo">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="Foreground" Value="{StaticResource T8Orange}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.logoSub">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Top bar buttons -->
  <Style Selector="Button.tool">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="#1D1D22" />
    <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Rectangle.divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Fill" Value="{StaticResource Outline}" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Outlined segmented buttons: the selected one lights up in its colour -->
  <Style Selector="ToggleButton.seg, Button.seg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="#C2C2CA" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="11,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.seg /template/ ContentPresenter, Button.seg /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.seg:pointerover /template/ ContentPresenter, Button.seg:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
    <Setter Property="BorderBrush" Value="#55555E" />
  </Style>
  <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter, Button.seg.active /template/ ContentPresenter">
    <Setter Property="Background" Value="#1FFF7A1A" />
    <Setter Property="BorderBrush" Value="{StaticResource T8Orange}" />
    <Setter Property="Foreground" Value="{StaticResource T8Orange}" />
  </Style>
  <Style Selector="ToggleButton.seg.green:checked /template/ ContentPresenter, Button.seg.green.active /template/ ContentPresenter">
    <Setter Property="Background" Value="#1F4CD38A" />
    <Setter Property="BorderBrush" Value="{StaticResource SectionGreen}" />
    <Setter Property="Foreground" Value="{StaticResource SectionGreen}" />
  </Style>
  <Style Selector="ToggleButton.seg.blue:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#1F4AA8FF" />
    <Setter Property="BorderBrush" Value="{StaticResource SectionBlue}" />
    <Setter Property="Foreground" Value="{StaticResource SectionBlue}" />
  </Style>
  <Style Selector="Button.seg:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Bank × pattern grid -->
  <Style Selector="Button.slot">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="#202025" />
    <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#D8D8DE" />
  </Style>
  <Style Selector="Button.slot.empty">
    <Setter Property="Foreground" Value="#5E5E66" />
    <Setter Property="Background" Value="#18181C" />
  </Style>
  <Style Selector="Button.slot.fill /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource SectionBlue}" />
  </Style>
  <Style Selector="Button.slot.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#2AFF7A1A" />
    <Setter Property="BorderBrush" Value="{StaticResource T8Orange}" />
    <Setter Property="Foreground" Value="{StaticResource T8Orange}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.bankLabel">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
    <Setter Property="Width" Value="52" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Song tab -->
  <Style Selector="Grid.songColumns">
    <Setter Property="ColumnSpacing" Value="8" />
  </Style>
  <Style Selector="Border.songRow">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
  </Style>
  <Style Selector="Border.songRow.current">
    <Setter Property="BorderBrush" Value="{StaticResource SectionGreen}" />
  </Style>
  <Style Selector="Border.songRow.queued">
    <Setter Property="BorderBrush" Value="White" />
  </Style>
  <!-- Compact controls in the song rows -->

  <Style Selector="Border.songRow NumericUpDown /template/ ButtonSpinner">
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Border.songRow NumericUpDown /template/ ButtonSpinner /template/ RepeatButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.songRow NumericUpDown /template/ TextBox">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,0,2,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.songRow TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="Border.songRow ToggleButton.seg, Border.songRow Button.seg">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Border.songRow Button.mini">
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Border.queuedOutline">
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="TextBlock.miniLabel">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mini">
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.swatch">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="ProgressBar.timeline">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ProgressBar.thin">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{StaticResource T8Orange}" />
    <Setter Property="Background" Value="#2A2A30" />
  </Style>
  <Style Selector="ProgressBar.thin.green">
    <Setter Property="Foreground" Value="{StaticResource SectionGreen}" />
  </Style>

  <!-- MIDI settings -->
  <Style Selector="TextBlock.settingName">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
  </Style>
  <Style Selector="RadioButton.option">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="RadioButton.option /template/ Border#RootBorder">
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="RadioButton.option /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>
  <Style Selector="RadioButton.option:checked">
    <Setter Property="Background" Value="#1FFF5C8A" />
    <Setter Property="BorderBrush" Value="{StaticResource SectionPink}" />
  </Style>
  <Style Selector="ToggleSwitch.compact">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="26" />
  </Style>
  <Style Selector="ToggleSwitch.compact /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.menuChip">
    <Setter Property="Background" Value="#1D1D22" />
    <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>

  <!-- Main tabs: a segmented control. A dark rounded track holds the tabs; the open tab is a raised orange pill. -->
  <Style Selector="TabControl#Tabs">
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border Classes="tabTrack" DockPanel.Dock="Top">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <ContentPresenter Name="PART_SelectedContentHost"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Border.tabTrack">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="#0C0C0F" />
    <Setter Property="BorderBrush" Value="#2A2A31" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="TabControl#Tabs > TabItem">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="#8E8E97" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TabControl#Tabs > TabItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabControl#Tabs > TabItem /template/ Border#PART_SelectedPipe, TabControl#Tabs > TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="TabControl#Tabs > TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#202026" />
  </Style>
  <Style Selector="TabControl#Tabs > TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#E4E4E9" />
  </Style>
  <Style Selector="TabControl#Tabs > TabItem:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#2A2A31" />
  </Style>
  <Style Selector="TabControl#Tabs > TabItem:selected /template/ Border#PART_LayoutRoot, TabControl#Tabs > TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FF9440" />
        <GradientStop Offset="1" Color="#F06A0E" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="TabControl#Tabs > TabItem:selected:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#E0600A" />
  </Style>
  <Style Selector="TabControl#Tabs > TabItem:selected /template/ ContentPresenter#PART_ContentPresenter, TabControl#Tabs > TabItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TabItem PathIcon.tabIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>

  <!-- Generator: labelled outlined boxes around combos (like OUT in the top bar), and instrument chips -->
  <Style Selector="Border.fieldBox">
    <Setter Property="Background" Value="#141418" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="BorderBrush" Value="#2C2C33" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="7,0,4,0" />
  </Style>
  <Style Selector="ToggleButton.chip, Button.chip">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="#141418" />
    <Setter Property="BorderBrush" Value="#2C2C33" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.chip PathIcon, Button.chip PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter, Button.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#222229" />
    <Setter Property="BorderBrush" Value="#3C3C45" />
    <Setter Property="Foreground" Value="#E4E4E9" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter, ToggleButton.chip:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#5AB2FF" />
        <GradientStop Offset="1" Color="#2B7FD9" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#7CC3FF" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.chip.orange:checked /template/ ContentPresenter, ToggleButton.chip.orange:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FF9440" />
        <GradientStop Offset="1" Color="#F06A0E" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FFB070" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.chip.small, ToggleButton.chip.small">
    <Setter Property="Height" Value="22" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="Border.card.strip">
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="ToggleButton.chip:pressed /template/ ContentPresenter, Button.chip:pressed /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="NumericUpDown.port">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown.port /template/ TextBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="NumericUpDown.port /template/ TextBox:pointerover /template/ Border#PART_BorderElement, NumericUpDown.port /template/ TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#1E1E24" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown.port /template/ ButtonSpinner">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown.port /template/ ButtonSpinner /template/ RepeatButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="NumericUpDown.port /template/ ButtonSpinner /template/ RepeatButton PathIcon, NumericUpDown.port /template/ ButtonSpinner /template/ RepeatButton Path">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
  </Style>
  <Style Selector="NumericUpDown.port /template/ ButtonSpinner /template/ RepeatButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#26262D" />
  </Style>
  <Style Selector="Rectangle.boxDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Fill" Value="#2C2C33" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.fieldBox ComboBox.port">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Rhythm grid cells -->
  <Style Selector="ToggleButton.cell">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="{StaticResource CellOff}" />
  </Style>
  <Style Selector="ToggleButton.cell.beat">
    <Setter Property="Background" Value="{StaticResource CellOffBeat}" />
  </Style>
  <Style Selector="ToggleButton.cell:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource T8Orange}" />
  </Style>
  <Style Selector="ToggleButton.cell.selected">
    <Setter Property="BorderBrush" Value="White" />
  </Style>
  <Style Selector="ToggleButton.cell.selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="White" />
  </Style>
  <Style Selector="ToggleButton.cell.playing">
    <Setter Property="BorderBrush" Value="{StaticResource Playing}" />
  </Style>
  <Style Selector="ToggleButton.cell.playing /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource Playing}" />
  </Style>
  <Style Selector="ToggleButton.cell.playing:not(:checked) /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PlayingDim}" />
  </Style>
  <Style Selector="PathIcon.trackIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Foreground" Value="#B4B4BD" />
  </Style>
  <Style Selector="Button.trackName.selected PathIcon.trackIcon">
    <Setter Property="Foreground" Value="{StaticResource T8Orange}" />
  </Style>
  <Style Selector="Button.trackName.selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource T8Orange}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="#2AFF7A1A" />
    <Setter Property="Foreground" Value="{StaticResource T8Orange}" />
  </Style>
  <Style Selector="Button.rowTool">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Button.rowTool PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="Button.rowTool:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="ToggleButton.cell.multi">
    <Setter Property="BorderBrush" Value="{StaticResource SectionBlue}" />
  </Style>
  <Style Selector="ToggleButton.cell.multi /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource SectionBlue}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="Border.batch">
    <Setter Property="Background" Value="#144AA8FF" />
    <Setter Property="BorderBrush" Value="{StaticResource SectionBlue}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="TextBlock.batchLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
  </Style>
  <Style Selector="TextBlock.batchValue">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Slider.batch">
    <Setter Property="Margin" Value="0,-8,0,-8" />
  </Style>
  <Style Selector="ComboBox.batch">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ToggleButton.cell.outside">
    <Setter Property="Opacity" Value="0.3" />
  </Style>

  <!-- Bass step columns -->
  <Style Selector="Border.bassStep">
    <Setter Property="Width" Value="41" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Padding" Value="2,4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{StaticResource CellOff}" />
  </Style>
  <Style Selector="Border.bassStep.beat">
    <Setter Property="Background" Value="{StaticResource CellOffBeat}" />
  </Style>
  <Style Selector="Border.bassStep.outside">
    <Setter Property="Opacity" Value="0.3" />
  </Style>
  <Style Selector="Border.bassStep Button, Border.bassStep ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Border.bassStep ToggleButton:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource T8Orange}" />
  </Style>
  <Style Selector="Border.bassStep.selected">
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="0,2" />
  </Style>
  <Style Selector="Border.bassStep.playing">
    <Setter Property="Background" Value="{StaticResource PlayingDim}" />
    <Setter Property="BorderBrush" Value="{StaticResource Playing}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="0,2" />
  </Style>
  <Style Selector="Button.note">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.note.on">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.state.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource T8Orange}" />
  </Style>

  <!-- Bass generator -->
  <Style Selector="Border.card TextBlock.label">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
  </Style>
  <Style Selector="Border.panel WrapPanel > ComboBox">
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="ToggleButton.instrument">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.instrument:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource T8Orange}" />
    <Setter Property="Foreground" Value="Black" />
  </Style>
  <Style Selector="StackPanel.chance">
    <Setter Property="Width" Value="140" />
    <Setter Property="Margin" Value="0,0,14,0" />
  </Style>
  <Style Selector="StackPanel.chance TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource T8Orange}" />
    <Setter Property="Foreground" Value="Black" />
  </Style>

  <Style Selector="TextBlock.header">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.picker">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.picker ListBoxItem">
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource CellOff}" />
  </Style>
  <Style Selector="ListBox.picker ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource T8Orange}" />
  </Style>
  <!-- Row tools: hover and pressed states; delete turns red -->
  <Style Selector="Button.rowTool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A2A32" />
    <Setter Property="BorderBrush" Value="#4A4A54" />
  </Style>
  <Style Selector="Button.rowTool:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#34343D" />
  </Style>
  <Style Selector="Button.rowTool.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#40E5484D" />
    <Setter Property="BorderBrush" Value="#E5484D" />
    <Setter Property="Foreground" Value="#FF6B70" />
  </Style>

  <!-- Song: outlined text fields, lit chips in the play area, the orange pill -->
  <Style Selector="TextBox.field">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="#CC141418" />
    <Setter Property="BorderBrush" Value="#3A3A42" />
  </Style>
  <Style Selector="Border.fieldBox TextBox.field">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.fieldBox TextBox.field:pointerover /template/ Border#PART_BorderElement, Border.fieldBox TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#1E1E24" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.chip.lit /template/ ContentPresenter, Button.chip.lit:pointerover /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FF9440" />
        <GradientStop Offset="1" Color="#F06A0E" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FFB070" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.chip:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.primary.pill">
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary.pill PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <!-- Outlined fields in the song rows (after the .port styles so the outline wins) -->
  <Style Selector="Border.songRow ComboBox.port, Border.songRow NumericUpDown.port">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#3A3A42" />
    <Setter Property="Background" Value="#CC141418" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.songRow NumericUpDown.port /template/ ButtonSpinner">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#3A3A42" />
    <Setter Property="Background" Value="#CC141418" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="NumericUpDown.port /template/ ButtonSpinner /template/ RepeatButton:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.chip:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#141418" />
    <Setter Property="BorderBrush" Value="#2C2C33" />
  </Style>
  <Style Selector="Border.songRow NumericUpDown.port /template/ TextBox">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0,2,0" />
  </Style>
  <Style Selector="Border.songRow NumericUpDown.port /template/ ButtonSpinner /template/ RepeatButton">
    <Setter Property="Width" Value="18" />
  </Style>
  <!-- Outlined .port combos and number fields outside boxes (MIDI settings) -->
  <Style Selector="ComboBox.port.outlined">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#2C2C33" />
    <Setter Property="Background" Value="#141418" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="NumericUpDown.port.outlined /template/ ButtonSpinner">
    <Setter Property="Height" Value="28" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#2C2C33" />
    <Setter Property="Background" Value="#141418" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ComboBox.port.outlined:pointerover /template/ Border#Background">
    <Setter Property="BorderBrush" Value="#4A4A54" />
  </Style>
  <Style Selector="NumericUpDown.port.outlined:pointerover /template/ ButtonSpinner">
    <Setter Property="BorderBrush" Value="#4A4A54" />
  </Style>
  <Style Selector="TextBlock.settingName">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
  </Style>
  <!-- Toggle switches lit in the app's orange -->
  <Style Selector="ToggleSwitch.compact:checked /template/ Border#SwitchKnobBounds, ToggleSwitch.compact:checked:pointerover /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{StaticResource T8Orange}" />
    <Setter Property="BorderBrush" Value="{StaticResource T8Orange}" />
  </Style>
  <!-- MIDI settings: focus highlight in outlined boxes, option cards -->
  <Style Selector="Border.fieldBox:pointerover">
    <Setter Property="BorderBrush" Value="#3E3E47" />
  </Style>
  <Style Selector="Border.fieldBox:focus-within">
    <Setter Property="BorderBrush" Value="#7A3A0C" />
    <Setter Property="Background" Value="#18181D" />
  </Style>
  <Style Selector="RadioButton.option">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="#141418" />
    <Setter Property="BorderBrush" Value="#2C2C33" />
  </Style>
  <Style Selector="RadioButton.option:pointerover /template/ Border#RootBorder">
    <Setter Property="BorderBrush" Value="#4A4A54" />
  </Style>
  <Style Selector="RadioButton.option:checked">
    <Setter Property="Background" Value="#1FFF7A1A" />
    <Setter Property="BorderBrush" Value="{StaticResource T8Orange}" />
  </Style>
  <Style Selector="RadioButton.option:checked /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Fill" Value="{StaticResource T8Orange}" />
    <Setter Property="Stroke" Value="{StaticResource T8Orange}" />
  </Style>
  <!-- Bass step numbers: click to select the step -->
  <Style Selector="Button.stepNumber">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.stepNumber:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.stepNumber:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
  </Style>
  <!-- The single-step panel: the multi-select panel's look in orange -->
  <Style Selector="Border.batch.single">
    <Setter Property="Background" Value="#14FF7A1A" />
    <Setter Property="BorderBrush" Value="{StaticResource T8Orange}" />
  </Style>
  <!-- Help: the small ? buttons next to panels, and the topic list in the help window -->
  <Style Selector="Button.helpTip">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.helpTip PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>
  <Style Selector="Button.helpTip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#26FF7A1A" />
    <Setter Property="Foreground" Value="{StaticResource T8Orange}" />
  </Style>
  <Style Selector="ListBox.helpTopics">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.helpTopics ListBoxItem">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.helpTopics ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#33FF7A1A" />
    <Setter Property="Foreground" Value="{StaticResource T8Orange}" />
  </Style>
</Styles>
