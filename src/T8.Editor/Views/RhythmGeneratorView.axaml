<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:T8.Editor.Help"
             xmlns:vm="using:T8.Editor.ViewModels"
             xmlns:views="using:T8.Editor.Views"
             x:Class="T8.Editor.Views.RhythmGeneratorView"
             x:DataType="vm:RhythmGeneratorViewModel">
  <Border Classes="card">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="7" Margin="0,0,0,8">
        <Ellipse Classes="dot" Fill="{StaticResource SectionBlue}" />
        <TextBlock Classes="cardTitle" Text="RHYTHM GENERATOR" />
        <views:HelpTip Tip="{x:Static help:HelpTips.RhythmGenerator}" />
      </StackPanel>

      <!-- Generate, randomize, undo and seed in one outlined panel -->
      <Border x:Name="RhythmActionPanel" DockPanel.Dock="Right" Classes="fieldBox" Padding="8" VerticalAlignment="Center" Margin="16,0,0,0" Width="280">
        <StackPanel Spacing="7">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Fill="{StaticResource SectionBlue}" />
            <TextBlock Classes="cardTitle" Text="ACTIONS" FontSize="10" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <Button x:Name="GenerateRhythmButton" Classes="primary pill" Command="{Binding GenerateCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" ToolTip.Tip="Replace the whole pattern. Same seed and settings, same pattern">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconGenerate}" />
                <TextBlock Text="Generate" />
              </StackPanel>
            </Button>
            <Button x:Name="VaryRhythmButton" Grid.Column="1" Classes="chip" Command="{Binding VaryCommand}" MinWidth="88"
                    HorizontalContentAlignment="Center" ToolTip.Tip="Keep what you lock (the kick by default). Rewrites hats and ghost notes, and step probability when Live variation is up">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconVary}" />
                <TextBlock Text="VARY" />
              </StackPanel>
            </Button>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="RandomizeRhythmButton" Classes="chip" Command="{Binding RandomizeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    ToolTip.Tip="New seed: a different pattern in the same style. This replaces the whole pattern">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconDice}" />
                <TextBlock Text="RANDOMIZE" />
              </StackPanel>
            </Button>
            <Button x:Name="UndoRhythmButton" Grid.Column="1" Classes="chip" Command="{Binding UndoCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    ToolTip.Tip="Undo the last generate, vary, fill bank or make fill">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconUndo}" />
                <TextBlock Text="UNDO" />
              </StackPanel>
            </Button>
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <Button x:Name="FillBankRhythmButton" Classes="chip" Command="{Binding FillBankCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="Write eight related patterns into the next empty slots, and copy the bass line with them">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconFillBank}" />
                <TextBlock Text="FILL BANK" />
              </StackPanel>
            </Button>
            <Border Grid.Column="1" Classes="fieldBox" MinHeight="0" Padding="0">
              <DockPanel>
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconSeed}" Width="11" Height="11" Foreground="{StaticResource MutedText}" Margin="10,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Classes="fieldLabel" Text="SEED" Margin="6,0,4,0" />
                <NumericUpDown Classes="port" x:Name="RhythmSeedInput" Value="{Binding Seed}" Minimum="1" Maximum="99999" FormatString="0" ShowButtonSpinner="False"
                               ToolTip.Tip="Same seed and settings, same result: type a number to get one back" />
              </DockPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Style, instruments, fill -->
      <StackPanel DockPanel.Dock="Left" Spacing="7" Margin="0,0,18,0">
        <Border Classes="fieldBox" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="fieldLabel" Text="STYLE" />
            <ComboBox x:Name="StylePicker" Classes="port" ItemsSource="{x:Static vm:RhythmGeneratorViewModel.Styles}" SelectedItem="{Binding Style}" Width="190" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ToggleButton x:Name="BassDrumChip" Classes="chip" IsChecked="{Binding BassDrum}" ToolTip.Tip="Bass drum">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="{StaticResource IconTrackBD}" />
              <TextBlock Text="BD" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="SnareChip" Classes="chip" IsChecked="{Binding Snare}" ToolTip.Tip="Snare">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="{StaticResource IconTrackSD}" />
              <TextBlock Text="SD" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="TomChip" Classes="chip" IsChecked="{Binding Tom}" ToolTip.Tip="Tom">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="{StaticResource IconTrackLT}" />
              <TextBlock Text="TOM" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="ClapChip" Classes="chip" IsChecked="{Binding Clap}" ToolTip.Tip="Hand clap">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="{StaticResource IconTrackHT}" />
              <TextBlock Text="CLAP" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="ClosedHatChip" Classes="chip" IsChecked="{Binding ClosedHat}" ToolTip.Tip="Closed hi-hat">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="{StaticResource IconTrackCH}" />
              <TextBlock Text="CH" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="OpenHatChip" Classes="chip" IsChecked="{Binding OpenHat}" ToolTip.Tip="Open hi-hat">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="{StaticResource IconTrackOH}" />
              <TextBlock Text="OH" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="fieldLabel" Text="LOCK" ToolTip.Tip="Lit locks are kept when you Vary. Generate still replaces the whole pattern" />
          <ToggleButton x:Name="LockBassDrumChip" Classes="chip small orange" IsChecked="{Binding LockBassDrum}" Content="BD"
                        ToolTip.Tip="Vary keeps the kick" />
          <ToggleButton x:Name="LockSnareChip" Classes="chip small orange" IsChecked="{Binding LockSnare}" Content="SD"
                        ToolTip.Tip="Vary keeps the snare's ghost notes and probability. The hits stay either way" />
          <ToggleButton x:Name="LockTomChip" Classes="chip small orange" IsChecked="{Binding LockTom}" Content="TOM"
                        ToolTip.Tip="Vary keeps the tom's step probability. The hits stay either way" />
          <ToggleButton x:Name="LockClapChip" Classes="chip small orange" IsChecked="{Binding LockClap}" Content="CLAP"
                        ToolTip.Tip="Vary keeps the clap's step probability. The hits stay either way" />
          <ToggleButton x:Name="LockClosedHatChip" Classes="chip small orange" IsChecked="{Binding LockClosedHat}" Content="CH"
                        ToolTip.Tip="Vary keeps the closed hat" />
          <ToggleButton x:Name="LockOpenHatChip" Classes="chip small orange" IsChecked="{Binding LockOpenHat}" Content="OH"
                        ToolTip.Tip="Vary keeps the open hat" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <ToggleButton x:Name="FillCheck" Classes="chip" IsChecked="{Binding Fill}" ToolTip.Tip="Snare and tom hits in the last four steps">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource IconBuildUp}" />
                <TextBlock Text="BUILD-UP AT END" />
              </StackPanel>
            </ToggleButton>
          <Border Classes="fieldBox">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="fieldLabel" Text="FILL" />
              <views:HelpTip Tip="{x:Static help:HelpTips.Fills}" />
              <ComboBox x:Name="FillPatternPicker" Classes="port" ItemsSource="{x:Static vm:RhythmGeneratorViewModel.PatternNumbers}" SelectedItem="{Binding FillPattern}" Width="66"
                        ToolTip.Tip="Fill pattern: the pattern in this bank that Make fill writes to and the Fill button plays" />
              <Button x:Name="MakeFillButton" Classes="tool" Command="{Binding MakeFillCommand}"
                      ToolTip.Tip="Write a fill for this pattern into the fill pattern: the groove, then a build-up. On the T-8, SHIFT + STEP 8 picks it as the fill">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconMakeFill}" />
                  <TextBlock Text="Make fill" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- Chances -->
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <views:Knob x:Name="DensityKnob" Value="{Binding Density}" Format="{}{0}%" DefaultValue="50" Label="Density"
                    Accent="{StaticResource SectionBlue}" ToolTip.Tip="50% follows the style; lower thins it out, higher fills it in" />
        <views:Knob Value="{Binding Variation}" Format="{}{0}%" DefaultValue="20" Label="Variation"
                    Accent="{StaticResource SectionBlue}" ToolTip.Tip="Extra hits off the style's template, and dropped optional ones" />
        <views:Knob Value="{Binding AccentChance}" Format="{}{0}%" DefaultValue="30" Label="Accents" Accent="{StaticResource SectionBlue}" />
        <views:Knob Value="{Binding GhostChance}" Format="{}{0}%" DefaultValue="15" Label="Ghost notes"
                    Accent="{StaticResource SectionBlue}" ToolTip.Tip="Quiet extra snare and hat notes between the main hits" />
        <views:Knob Value="{Binding RollChance}" Format="{}{0}%" DefaultValue="10" Label="Rolls"
                    Accent="{StaticResource SectionBlue}" ToolTip.Tip="Hat rolls (sub steps) and snare flams" />
        <views:Knob Value="{Binding LiveVariation}" Format="{}{0}%" DefaultValue="0" Label="Live variation"
                    Accent="{StaticResource SectionBlue}" ToolTip.Tip="Optional hits get a T-8 step probability of 50–80%, so the T-8 varies the pattern every loop" />
      </WrapPanel>
    </DockPanel>
  </Border>
</UserControl>
