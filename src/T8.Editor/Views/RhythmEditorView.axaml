<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:help="using:T8.Editor.Help"
             xmlns:vm="using:T8.Editor.ViewModels"
             xmlns:views="using:T8.Editor.Views"
             x:Class="T8.Editor.Views.RhythmEditorView"
             x:DataType="vm:RhythmEditorViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopySelectedTrackCommand}" />
    <KeyBinding Gesture="Meta+C" Command="{Binding CopySelectedTrackCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteToSelectedTrackCommand}" />
    <KeyBinding Gesture="Meta+V" Command="{Binding PasteToSelectedTrackCommand}" />
  </UserControl.KeyBindings>
  <DockPanel Margin="0,8,0,0">
    <!-- Pattern settings and cell inspector -->
    <ScrollViewer DockPanel.Dock="Right" Width="256" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Width="240" Spacing="8" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="header" Text="Pattern" VerticalAlignment="Center" />
        <views:HelpTip Topic="{x:Static help:HelpTopics.Rhythm}" />
      </StackPanel>
      <StackPanel x:Name="PatternKnobs" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
        <views:Knob x:Name="RhythmLength" Value="{Binding Length}" Minimum="1" Maximum="32" DefaultValue="16" Label="Last step"
                    ToolTip.Tip="Steps 1 to this one play; the rest are skipped" />
        <views:Knob x:Name="ShuffleInput" Value="{Binding Shuffle}" Minimum="0" Maximum="200" DefaultValue="0" Label="Shuffle"
                    ToolTip.Tip="Delays every second 16th note (0 = straight)" />
        <views:Knob x:Name="FlamInput" Value="{Binding Flam}" Minimum="0" Maximum="100" DefaultValue="36" Label="Flam"
                    ToolTip.Tip="Spacing of the two hits of a flam sub step" />
      </StackPanel>

      <!-- Several active steps picked with Ctrl/Cmd/Shift-click: edit them together -->
      <Border x:Name="BatchInspector" Classes="batch" Margin="0,10,0,0" HorizontalAlignment="Left"
              Width="{Binding #PatternKnobs.Bounds.Width}" IsVisible="{Binding HasMultiSelection}">
        <StackPanel Spacing="2">
          <DockPanel Margin="0,0,0,4" MinHeight="22">
            <views:HelpTip DockPanel.Dock="Right" Topic="{x:Static help:HelpTopics.MultiSelect}" />
            <TextBlock x:Name="MultiSelectionText" Text="{Binding MultiSelectionLabel}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource SectionBlue}" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding BatchVelocity, StringFormat='v.{0}'}" Classes="batchValue" />
            <TextBlock Text="Velocity" Classes="batchLabel" />
          </DockPanel>
          <Slider x:Name="BatchVelocitySlider" Classes="batch" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BatchVelocity}" />
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding BatchProbabilityPercent, StringFormat='{}{0}%'}" Classes="batchValue" />
            <TextBlock Text="Probability" Classes="batchLabel" />
          </DockPanel>
          <Slider Classes="batch" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding BatchProbabilityPercent}" />
          <DockPanel Margin="0,2,0,0">
            <TextBlock Text="SUB STEP" Classes="fieldLabel" Margin="0,0,8,0" />
            <ComboBox x:Name="BatchSubStepPicker" Classes="port outlined" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Static vm:RhythmEditorViewModel.SubStepOptions}" SelectedItem="{Binding BatchSubStep}" />
          </DockPanel>
          <DockPanel IsVisible="{Binding BatchHasSubStep}" Margin="0,2,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding BatchSubStepProbabilityPercent, StringFormat='{}{0}%'}" Classes="batchValue" />
            <TextBlock Text="Sub step prob." Classes="batchLabel" />
          </DockPanel>
          <Slider Classes="batch" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding BatchSubStepProbabilityPercent}"
                  IsVisible="{Binding BatchHasSubStep}" />
          <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,4,0,0">
            <Button x:Name="ApplyToSelectionButton" Classes="primary small" Content="Apply" Command="{Binding ApplyToSelectionCommand}"
                    ToolTip.Tip="Set these values on every selected step, then clear the selection" />
            <Button x:Name="ClearSelectionButton" Classes="seg small" Content="Clear" Command="{Binding ClearMultiSelectionCommand}"
                    ToolTip.Tip="Clear the selection without changing anything" />
          </StackPanel>
        </StackPanel>
      </Border>


      <!-- One step selected: the same compact panel as the multi-select one, in orange -->
      <Border x:Name="Inspector" Classes="batch single" Margin="0,10,0,0" HorizontalAlignment="Left"
              Width="{Binding #PatternKnobs.Bounds.Width}">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="SelectedCell" Converter="{x:Static ObjectConverters.IsNotNull}" />
            <Binding Path="!HasMultiSelection" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel Spacing="2">
          <DockPanel Margin="0,0,0,4" MinHeight="22">
            <ToggleButton x:Name="SelectedStepOnToggle" DockPanel.Dock="Right" Classes="chip small orange"
                          IsChecked="{Binding SelectedCell.On, FallbackValue=False}" ToolTip.Tip="Turn this step on or off">
              <TextBlock Text="ON" />
            </ToggleButton>
            <TextBlock x:Name="SelectedStepText" Text="{Binding SelectedCell.Description, FallbackValue=''}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource T8Orange}" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCell.Velocity, StringFormat='v.{0}', FallbackValue=''}" Classes="batchValue" />
            <TextBlock Text="Velocity" Classes="batchLabel" />
          </DockPanel>
          <Slider x:Name="VelocitySlider" Classes="batch" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding SelectedCell.Velocity, FallbackValue=0}" />
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCell.ProbabilityPercent, StringFormat='{}{0}%', FallbackValue=''}" Classes="batchValue" />
            <TextBlock Text="Probability" Classes="batchLabel" />
          </DockPanel>
          <Slider x:Name="ProbabilitySlider" Classes="batch" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"
                  Value="{Binding SelectedCell.ProbabilityPercent, FallbackValue=100}" />
          <DockPanel Margin="0,2,0,0">
            <TextBlock Text="SUB STEP" Classes="fieldLabel" Margin="0,0,8,0" />
            <ComboBox x:Name="SubStepPicker" Classes="port outlined" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Static vm:RhythmEditorViewModel.SubStepOptions}"
                      SelectedItem="{Binding SelectedCell.SubStep, FallbackValue={x:Null}}" />
          </DockPanel>
          <DockPanel IsVisible="{Binding SelectedCell.HasSubStep, FallbackValue=False}" Margin="0,2,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCell.SubStepProbabilityPercent, StringFormat='{}{0}%', FallbackValue=''}" Classes="batchValue" />
            <TextBlock Text="Sub step prob." Classes="batchLabel" />
          </DockPanel>
          <Slider Classes="batch" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"
                  Value="{Binding SelectedCell.SubStepProbabilityPercent, FallbackValue=100}"
                  IsVisible="{Binding SelectedCell.HasSubStep, FallbackValue=False}" />
        </StackPanel>
      </Border>

      <!-- Picking several steps -->
      <StackPanel Spacing="4" Margin="0,10,0,0" IsVisible="{Binding !HasMultiSelection}">
        <Button x:Name="SelectAllActiveButton" Classes="seg" Content="Select all active steps" Command="{Binding SelectAllActiveCommand}"
                HorizontalAlignment="Left" ToolTip.Tip="Pick every active step to set velocity, probability and sub step for all of them" />
        <TextBlock Text="Ctrl/Cmd-click or Shift-click active steps to pick several." FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedText}" />
      </StackPanel>
    </StackPanel>
    </ScrollViewer>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="4">
        <!-- Step numbers -->
        <StackPanel Orientation="Horizontal" Margin="126,0,0,0">
          <ItemsControl ItemsSource="{Binding Tracks[0].Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RhythmCellViewModel">
                <TextBlock Width="26" TextAlignment="Center" FontSize="11" Opacity="0.6" Text="{Binding StepNumber}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ItemsControl x:Name="TrackRows" ItemsSource="{Binding Tracks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RhythmTrackViewModel">
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <Button Classes="trackName" Classes.selected="{Binding IsSelected}" Width="118" Margin="0,0,8,0"
                        HorizontalContentAlignment="Left"
                        ToolTip.Tip="Select this row (then Cmd/Ctrl+C to copy it, Cmd/Ctrl+V to paste into it)"
                        Command="{Binding $parent[UserControl].((vm:RhythmEditorViewModel)DataContext).SelectTrackCommand, FallbackValue={x:Null}}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Classes="trackIcon" Data="{Binding Track, Converter={x:Static vm:Converters.TrackIcon}}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Cells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RhythmCellViewModel">
                      <ToggleButton Classes="cell"
                                    Classes.beat="{Binding IsBeat}"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.outside="{Binding !IsInLength}"
                                    Classes.playing="{Binding IsPlaying}"
                                    Classes.multi="{Binding IsMultiSelected}"
                                    IsChecked="{Binding On}"
                                    Command="{Binding ActivateCommand}"
                                    ToolTip.Tip="{Binding Description}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0,0,0" VerticalAlignment="Center">
                  <Button Classes="rowTool" ToolTip.Tip="Copy this row"
                          Command="{Binding $parent[UserControl].((vm:RhythmEditorViewModel)DataContext).CopyTrackCommand, FallbackValue={x:Null}}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconCopy}" />
                  </Button>
                  <Button Classes="rowTool"
                          IsEnabled="{Binding $parent[UserControl].((vm:RhythmEditorViewModel)DataContext).Clipboard.HasContent, FallbackValue=False}"
                          ToolTip.Tip="{Binding $parent[UserControl].((vm:RhythmEditorViewModel)DataContext).Clipboard.PasteTip, FallbackValue=''}"
                          Command="{Binding $parent[UserControl].((vm:RhythmEditorViewModel)DataContext).PasteTrackCommand, FallbackValue={x:Null}}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconPaste}" />
                  </Button>
                  <Button Classes="rowTool" ToolTip.Tip="Clear this row"
                          Command="{Binding $parent[UserControl].((vm:RhythmEditorViewModel)DataContext).ClearTrackCommand, FallbackValue={x:Null}}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource IconEraser}" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
