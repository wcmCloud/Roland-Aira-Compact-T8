<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:T8.Editor.Help"
        xmlns:vm="using:T8.Editor.ViewModels"
        xmlns:views="using:T8.Editor.Views"
        xmlns:ports="using:T8.Midi.Ports"
        x:Class="T8.Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://T8Editor/Assets/AppIcon.png"
        Title="{Binding Title}"
        Width="1440" Height="800" MinWidth="900" MinHeight="640"
        Background="{StaticResource WindowBg}">
  <Window.KeyBindings>
    <KeyBinding Gesture="F1" Command="{Binding ShowHelpCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <!-- Top bar: files, T-8 drive, pattern clipboard, MIDI connection -->
    <Border DockPanel.Dock="Top" Classes="topbarAccent" />
    <Border DockPanel.Dock="Top" Classes="topbar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <Border Classes="toolgroup">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="OUT" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="10"
                         FontWeight="SemiBold" LetterSpacing="1" Margin="7,0,2,0" />
              <ComboBox x:Name="PortPicker" Classes="port" MinWidth="140" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                        PlaceholderText="No MIDI outputs">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="ports:MidiPortInfo">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="RefreshButton" Classes="tool icon" Command="{Binding RefreshPortsCommand}" ToolTip.Tip="Refresh MIDI ports">
                <PathIcon Data="{StaticResource IconRefresh}" />
              </Button>
              <Button x:Name="TestConnectionButton" Classes="tool" Command="{Binding TestConnectionCommand}" ToolTip.Tip="Play test sounds on the T-8 and check that it answers">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconPulse}" />
                  <TextBlock Text="Test" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Classes="toolgroup">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="MidiSettingsButton" Classes="tool icon" Command="{Binding OpenMidiSettingsCommand}"
                      ToolTip.Tip="MIDI settings: channels, drum notes, what Play does">
                <PathIcon Data="{StaticResource IconCog}" />
              </Button>
              <Button x:Name="HelpButton" Classes="tool icon" Command="{Binding ShowHelpCommand}" ToolTip.Tip="Help (F1)">
                <PathIcon Data="{StaticResource IconHelp}" />
              </Button>
              <Button x:Name="AboutButton" Classes="tool icon" Command="{Binding ShowAboutCommand}" ToolTip.Tip="About this editor">
                <PathIcon Data="{StaticResource IconInfo}" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Border Classes="logoBadge" Margin="0,0,4,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="logo" Text="T-8" />
              <TextBlock Classes="logoSub" Text="EDITOR" />
            </StackPanel>
          </Border>
          <Border Classes="toolgroup">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="NewButton" Classes="tool" Command="{Binding NewLibraryCommand}" ToolTip.Tip="64 blank patterns">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconNew}" />
                  <TextBlock Text="New" />
                </StackPanel>
              </Button>
              <Button x:Name="OpenButton" Classes="tool" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open a pattern folder. Starts in original presets">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconOpen}" />
                  <TextBlock Text="Open…" />
                </StackPanel>
              </Button>
              <Button x:Name="SaveButton" Classes="tool" Command="{Binding SaveCommand}" HotKey="Ctrl+S" ToolTip.Tip="Save the patterns (Ctrl/Cmd+S)">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconSave}" />
                  <TextBlock Text="Save" />
                </StackPanel>
              </Button>
              <Button x:Name="SaveAsButton" Classes="tool" Command="{Binding SaveAsCommand}" ToolTip.Tip="Save the patterns to another folder">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconSaveAs}" />
                  <TextBlock Text="Save as…" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Classes="toolgroup">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Ellipse x:Name="T8DriveDot" Classes="driveDot" Classes.on="{Binding IsT8DriveConnected}" ToolTip.Tip="{Binding T8DriveStatus}" />
              <Button x:Name="LoadFromT8Button" Classes="tool t8" Command="{Binding LoadFromT8Command}" ToolTip.Tip="Read the patterns from the T-8 drive (the T-8 in drive mode: switch it on while holding PLAY)">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconLoadFrom}" />
                  <TextBlock Text="Load from T-8" />
                </StackPanel>
              </Button>
              <Button x:Name="WriteToT8Button" Classes="tool t8" Command="{Binding WriteToT8Command}" ToolTip.Tip="Write all 64 patterns to the T-8 drive's RESTORE folder">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconWriteTo}" />
                  <TextBlock Text="Write to T-8" />
                </StackPanel>
              </Button>
              <Button x:Name="CheckT8DriveButton" Classes="tool" Command="{Binding CheckT8DriveCommand}" ToolTip.Tip="Look for the T-8 drive again">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconSearch}" />
                  <TextBlock Text="Check" />
                </StackPanel>
              </Button>
              <views:HelpTip x:Name="T8DriveHelp" Tip="{x:Static help:HelpTips.DriveMode}" Margin="2,0,4,0" />
            </StackPanel>
          </Border>
          <Border Classes="toolgroup">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="CopyButton" Classes="tool" Command="{Binding CopyPatternCommand}" ToolTip.Tip="Copy this pattern (bass and rhythm)">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconCopy}" />
                  <TextBlock Text="Copy" />
                </StackPanel>
              </Button>
              <Button x:Name="PasteButton" Classes="tool" Command="{Binding PastePatternCommand}" ToolTip.Tip="Paste into this pattern">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconPaste}" />
                  <TextBlock Text="Paste" />
                </StackPanel>
              </Button>
              <Button x:Name="ClearButton" Classes="tool" Command="{Binding ClearPatternCommand}" ToolTip.Tip="Clear this pattern">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconEraser}" />
                  <TextBlock Text="Clear" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Patterns and playback -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="12,6,12,0">
      <Border x:Name="PatternsCard" Classes="card">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Fill="{StaticResource SectionOrange}" />
            <TextBlock Classes="cardTitle" Text="PATTERNS" />
            <views:HelpTip Tip="{x:Static help:HelpTips.Patterns}" />
            <TextBlock Text="{Binding PatternLabel}" FontSize="11" Foreground="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
            <Ellipse x:Name="UnsavedDot" Width="7" Height="7" Fill="{StaticResource T8Orange}" Margin="10,0,0,0" VerticalAlignment="Center"
                     IsVisible="{Binding IsDirty}" ToolTip.Tip="Unsaved changes" />
            <TextBlock x:Name="LibraryText" Text="{Binding LibraryLabel}" FontSize="11" Foreground="{StaticResource MutedText}" Opacity="0.75"
                       Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"
                       ToolTip.Tip="{Binding FolderPath}" />
          </StackPanel>
          <ItemsControl x:Name="PatternGrid" ItemsSource="{Binding PatternBanks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PatternBankRow">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                  <TextBlock Classes="bankLabel" Text="{Binding Label}" />
                  <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PatternSlotViewModel">
                        <Button Classes="slot" Classes.selected="{Binding IsSelected}" Classes.empty="{Binding IsEmpty}"
                                Classes.fill="{Binding IsFill}" Content="{Binding Pattern}" Command="{Binding SelectCommand}"
                                ToolTip.Tip="{Binding ToolTip}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border x:Name="PlaybackCard" Grid.Column="1" Classes="card" Margin="10,0,0,0">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Fill="{StaticResource SectionGreen}" />
            <TextBlock Classes="cardTitle" Text="PLAYBACK" />
            <views:HelpTip Tip="{x:Static help:HelpTips.Playback}" />
          </StackPanel>
          <!-- Output and its local sound controls share one compact panel. -->
          <Border x:Name="OutputPanel" Classes="toolgroup" Padding="8,5">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Output" FontSize="11" Foreground="{StaticResource MutedText}" />
                <ComboBox x:Name="OutputModePicker" Classes="port" ItemsSource="{Binding OutputModes}" SelectedItem="{Binding OutputMode}" Width="110" ToolTip.Tip="{Binding OutputSummary}" />
              </StackPanel>
          <WrapPanel Grid.Column="1" Margin="12,0,0,0" x:Name="OfflineSoundControls" IsVisible="{Binding IsOffline}">
            <StackPanel Margin="0,0,12,0" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Sound preset" FontSize="11" Foreground="{StaticResource MutedText}" />
              <ComboBox x:Name="OfflinePresetPicker" Classes="port" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Width="160" />
            </StackPanel>
            <views:Knob x:Name="OfflineVolumeKnob" Minimum="0" Maximum="1" Step="0.01"
                        DefaultValue="0.45" Value="{Binding OfflineVolume}" Label="VOLUME" Format="{}{0:P0}"
                        Accent="{StaticResource SectionGreen}" Margin="0,0,12,0"
                        ToolTip.Tip="Computer playback volume" />
            <Button x:Name="OfflineSoundSettingsButton" Classes="primary pill"
                    Height="28" MinHeight="0" Padding="8,0" FontSize="11.5" VerticalAlignment="Center" Margin="0,18,0,0">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconCog}" />
                <TextBlock Text="Sound settings" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="Bottom">
                  <ScrollViewer MaxHeight="580" VerticalScrollBarVisibility="Auto">
                  <StackPanel Width="360" Spacing="12">
                    <Border CornerRadius="8" Padding="12" Background="#142D27" BorderBrush="#305848" BorderThickness="1">
                      <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Data="{StaticResource IconCog}" Width="16" Height="16" Foreground="{StaticResource SectionGreen}" />
                          <TextBlock Text="SOUND SETTINGS" Classes="cardTitle" />
                        </StackPanel>
                        <TextBlock Text="{Binding Preset.Name}" FontSize="12" Foreground="{StaticResource SectionGreen}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="toolgroup" Padding="12">
                      <StackPanel Spacing="9">
                        <TextBlock Text="AUDIO OUTPUT" Classes="cardTitle" FontSize="10" Foreground="{StaticResource MutedText}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <ComboBox Classes="port" ItemsSource="{Binding AudioOutputs}" SelectedItem="{Binding AudioOutput}" HorizontalAlignment="Stretch" />
                          <Button Grid.Column="1" Classes="tool" Command="{Binding RefreshAudioOutputsCommand}" ToolTip.Tip="Refresh audio outputs" Height="28" MinHeight="0" Padding="7,0">
                            <PathIcon Data="{StaticResource IconRefresh}" />
                          </Button>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Classes="toolgroup" Padding="12">
                      <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="BASS VOICE" Classes="cardTitle" FontSize="10" />
                            <TextBlock Text="Shape your preview sound" FontSize="11" Foreground="{StaticResource MutedText}" />
                          </StackPanel>
                          <ComboBox Grid.Column="1" Classes="port" ItemsSource="{Binding BassWaves}" SelectedItem="{Binding Wave}" Width="110" ToolTip.Tip="Bass waveform" />
                        </Grid>
                        <Border Height="1" Background="#2C2C33" />
                        <UniformGrid Columns="4">
                          <views:Knob x:Name="OfflineCutoffKnob" Label="CUTOFF" Minimum="80" Maximum="10000" Step="10" Value="{Binding Cutoff}" Format="{}{0:0} Hz" Accent="{StaticResource SectionGreen}" ToolTip.Tip="Low-pass filter cutoff" />
                          <views:Knob x:Name="OfflineResonanceKnob" Label="RESONANCE" Minimum="0.5" Maximum="4" Step="0.05" Value="{Binding Resonance}" Format="{}{0:0.00}" Accent="{StaticResource SectionGreen}" ToolTip.Tip="Filter resonance" />
                          <views:Knob x:Name="OfflineDecayKnob" Label="DECAY" Minimum="0.04" Maximum="2" Step="0.01" Value="{Binding Decay}" Format="{}{0:0.00} s" Accent="{StaticResource SectionGreen}" ToolTip.Tip="Bass envelope decay" />
                          <views:Knob x:Name="OfflineSlideKnob" Label="SLIDE" Minimum="0.005" Maximum="0.5" Step="0.005" Value="{Binding Slide}" Format="{}{0:0.00} s" Accent="{StaticResource SectionGreen}" ToolTip.Tip="Time to glide between notes" />
                        </UniformGrid>
                      </StackPanel>
                    </Border>
                    <Border Classes="toolgroup" Padding="12">
                      <StackPanel Spacing="8">
                        <TextBlock Text="INSTRUMENT MIX" Classes="cardTitle" FontSize="10" />
                        <TextBlock Text="Individual levels · 0% mutes the instrument" FontSize="11" Foreground="{StaticResource MutedText}" />
                        <UniformGrid Columns="4">
                          <views:Knob Label="KICK" Minimum="0" Maximum="1" Step="0.01" DefaultValue="1" Value="{Binding KickVolume}" Format="{}{0:P0}" Accent="{StaticResource SectionGreen}" />
                          <views:Knob Label="SNARE" Minimum="0" Maximum="1" Step="0.01" DefaultValue="1" Value="{Binding SnareVolume}" Format="{}{0:P0}" Accent="{StaticResource SectionGreen}" />
                          <views:Knob Label="TOM" Minimum="0" Maximum="1" Step="0.01" DefaultValue="1" Value="{Binding TomVolume}" Format="{}{0:P0}" Accent="{StaticResource SectionGreen}" />
                          <views:Knob Label="CLAP" Minimum="0" Maximum="1" Step="0.01" DefaultValue="1" Value="{Binding ClapVolume}" Format="{}{0:P0}" Accent="{StaticResource SectionGreen}" />
                          <views:Knob Label="CLOSED HAT" Minimum="0" Maximum="1" Step="0.01" DefaultValue="1" Value="{Binding ClosedHatVolume}" Format="{}{0:P0}" Accent="{StaticResource SectionGreen}" />
                          <views:Knob Label="OPEN HAT" Minimum="0" Maximum="1" Step="0.01" DefaultValue="1" Value="{Binding OpenHatVolume}" Format="{}{0:P0}" Accent="{StaticResource SectionGreen}" />
                          <views:Knob Label="BASS" Minimum="0" Maximum="1" Step="0.01" DefaultValue="1" Value="{Binding BassVolume}" Format="{}{0:P0}" Accent="{StaticResource SectionGreen}" />
                        </UniformGrid>
                      </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,0">
                      <PathIcon Data="{StaticResource IconInfo}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{StaticResource MutedText}" />
                      <TextBlock Grid.Column="1" Text="Preview sounds only. Transferred patterns use the T-8’s own sounds." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedText}" />
                    </Grid>
                  </StackPanel>
                  </ScrollViewer>
                </Flyout>
              </Button.Flyout>
            </Button>
          </WrapPanel>
              <TextBlock x:Name="OutputStatusText" Grid.Column="2" Text="{Binding OutputSummary}" IsVisible="{Binding !IsOffline}" VerticalAlignment="Center" Foreground="{StaticResource SectionGreen}" Margin="12,18,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OutputSummary}" />
            </Grid>
          </Border>
          <Border Classes="toolgroup" Padding="8,5">
          <Grid ColumnDefinitions="Auto,*">
            <views:Knob x:Name="BpmKnob" Value="{Binding Bpm}" Minimum="20" Maximum="300" DefaultValue="120" Label="BPM"
                        Accent="{StaticResource SectionGreen}" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <WrapPanel Orientation="Horizontal">
                <Button x:Name="PlayButton" Classes="seg green" Classes.active="{Binding IsPlaying}" Command="{Binding PlayCommand}" ToolTip.Tip="Play this pattern through the selected output">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" />
                    <TextBlock Text="PLAY" />
                  </StackPanel>
                </Button>
                <Button x:Name="StopButton" Classes="seg" Command="{Binding StopCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource IconStop}" Width="10" Height="10" />
                    <TextBlock Text="STOP" />
                  </StackPanel>
                </Button>
                <Button x:Name="PauseButton" Classes="seg" Classes.active="{Binding IsPaused}" Command="{Binding PauseCommand}"
                        ToolTip.Tip="Pause; Play or Pause again carries on from the same place (MIDI Continue for the T-8's sequencer)">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource IconPause}" Width="11" Height="11" />
                    <TextBlock Text="PAUSE" />
                  </StackPanel>
                </Button>
                <Button x:Name="FillButton" Classes="seg" Content="FILL" Command="{Binding PlayFillCommand}"
                        ToolTip.Tip="Play the fill pattern once after this loop, like FILL TRG on the T-8 (set the fill pattern on the Rhythm tab)" />
                <Button x:Name="SelectOnT8Button" IsVisible="{Binding !IsOffline}" IsEnabled="{Binding !IsOffline}" Classes="seg" Content="SELECT ON T-8" Command="{Binding SelectOnT8Command}" Margin="8,0,0,0"
                        ToolTip.Tip="Switch the T-8 to this bank and pattern (needs RX Program Change on)" />
              </WrapPanel>
              <Border Classes="toolgroup">
              <WrapPanel Orientation="Horizontal">
                <TextBlock x:Name="T8StatusText" Text="{Binding T8Status}" Foreground="{StaticResource SectionGreen}" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                           IsVisible="{Binding T8Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ToggleButton x:Name="AuditionCheck" Margin="0,0,8,0" Classes="seg" Content="AUDITION" IsChecked="{Binding AuditionEnabled}"
                              ToolTip.Tip="Hear steps through the selected output as you edit them" />
                <ToggleButton x:Name="PlayheadCheck" Margin="0,0,8,0" Classes="seg" Content="SHOW PLAYING STEP" IsChecked="{Binding ShowPlayhead}"
                              ToolTip.Tip="Highlight the step being played, and the bass note on the keyboard" />
                <ToggleButton x:Name="FollowClockCheck" Classes="seg" Content="FOLLOW CLOCK" IsChecked="{Binding FollowExternalClock}"
                              ToolTip.Tip="Pattern Play follows an external MIDI clock instead of the BPM knob. Press Play to arm, then start that clock." />
              </WrapPanel>
              </Border>
              <Border Classes="toolgroup" IsVisible="{Binding FollowExternalClock}">
              <WrapPanel x:Name="ClockInputRow" Orientation="Horizontal" IsVisible="{Binding FollowExternalClock}">
                <ComboBox x:Name="ClockInputBox" Classes="port" MinWidth="160" ItemsSource="{Binding ClockInputs}" SelectedItem="{Binding ClockInput}"
                          PlaceholderText="Clock input" ToolTip.Tip="The port that sends MIDI clock, such as IAC or loopMIDI. Not the T-8's own output.">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="ports:MidiPortInfo">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="RefreshClockInputsButton" Classes="seg" Content="REFRESH INPUTS" Command="{Binding RefreshClockInputsCommand}" />
              </WrapPanel>
              </Border>
            </StackPanel>
          </Grid>
          </Border>

        </StackPanel>
      </Border>
    </Grid>

    <DockPanel DockPanel.Dock="Bottom" Margin="12,6,12,8">
      <StackPanel DockPanel.Dock="Right" x:Name="MidiSummaryText" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0"
                  VerticalAlignment="Center" ToolTip.Tip="{Binding MidiSummary}">
        <Border Classes="midiPill" Classes.off="{Binding !BassChannelOn}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="midiLabel" Text="BASS" />
            <Border Classes="midiBadge bass">
              <TextBlock Classes="midiValue" Text="{Binding BassChannelText}" />
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="midiPill" Classes.off="{Binding !RhythmChannelOn}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="midiLabel" Text="RHYTHM" />
            <Border Classes="midiBadge rhythm">
              <TextBlock Classes="midiValue" Text="{Binding RhythmChannelText}" />
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="midiPill">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="midiLabel" Text="SELECT" />
            <Border Classes="midiBadge select">
              <TextBlock Classes="midiValue" Text="{Binding PatternChannelText}" />
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="midiPill" IsVisible="{Binding PlaysOnT8}" ToolTip.Tip="Play runs the T-8's own sequencer">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="midiLabel" Text="T-8" />
            <Border Classes="midiBadge sync">
              <TextBlock Classes="midiValue" Text="SEQ" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
      <Button DockPanel.Dock="Right" x:Name="UpdateChip" Classes="chip small lit" Margin="12,-4,0,-4"
              IsVisible="{Binding HasUpdate}" Command="{Binding OpenUpdatePageCommand}" ToolTip.Tip="{Binding UpdateTip}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <PathIcon Data="{StaticResource IconLoadFrom}" Width="11" Height="11" />
          <TextBlock Text="{Binding UpdateLabel}" />
        </StackPanel>
      </Button>
      <TextBlock x:Name="StatusText" Classes="status" Classes.highlight="{Binding StatusHighlighted}" Text="{Binding Status}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </DockPanel>

    <TabControl x:Name="Tabs" Margin="12,6,12,0" SelectedIndex="{Binding SelectedTab}">
      <TabItem x:Name="RhythmTab" ToolTip.Tip="Drum pattern: the step grid and the rhythm generator">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Classes="tabIcon" Data="{StaticResource IconTabRhythm}" />
            <TextBlock Text="Rhythm" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <DockPanel>
          <Expander x:Name="RhythmGeneratorExpander" DockPanel.Dock="Bottom" Header="Rhythm generator" IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,4,0,0">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <views:RhythmGeneratorView DataContext="{Binding RhythmGenerator}" />
            </ScrollViewer>
          </Expander>
          <views:RhythmEditorView DataContext="{Binding Rhythm}" />
        </DockPanel>
      </TabItem>
      <TabItem x:Name="BassTab" ToolTip.Tip="Bass line: the steps, piano keyboard and bass generator">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Classes="tabIcon" Data="{StaticResource IconTabBass}" />
            <TextBlock Text="Bass" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <DockPanel>
          <Expander x:Name="BassGeneratorExpander" DockPanel.Dock="Bottom" Header="Bass generator" IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,4,0,0">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <views:BassGeneratorView DataContext="{Binding BassGenerator}" />
            </ScrollViewer>
          </Expander>
          <views:BassEditorView DataContext="{Binding Bass}" />
        </DockPanel>
      </TabItem>
      <TabItem x:Name="SongTab" ToolTip.Tip="Song: chain patterns with repeats and fills, and play them">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Classes="tabIcon" Data="{StaticResource IconTabSong}" />
            <TextBlock Text="Song" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <views:SongView DataContext="{Binding Song}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
